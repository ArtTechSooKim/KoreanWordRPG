  m_Script: {fileID: 11500000, guid: 3b72d5cf44eaeb8458f8605263c9da22, type: 3}
  m_Name: tier2_advanced
  m_EditorClassIdentifier: WordRPG::WordRPG.Words.WordDatabase
  tier: 2
  regionId: advanced
  regionName: "\uC232\xB7\uC815\uAE00\xB7\uB3D9\uAD74"
  rewards:
  - regionId: forest
    regionName: "\uC232"
    keepsake: {fileID: 11400000, guid: 05119db81daf98c49945dbb01ce077ad, type: 2}
    gold: 700
    wordsNeeded: 100
    storyOrder: 3
  - regionId: jungle
    regionName: "\uBA54\uC544\uB9AC \uC815\uAE00"
    keepsake: {fileID: 11400000, guid: d7331af346374d9498d7f7ff5e31ae27, type: 2}
    gold: 800
    wordsNeeded: 200
    storyOrder: 4
  - regionId: cave
    regionName: "\uC5B4\uB450\uC6B4 \uBC00\uB9BC \uB3D9\uAD74"
    keepsake: {fileID: 11400000, guid: 528fd9a2b4a378f4eaf4f4d0509121e2, type: 2}
    gold: 900
    wordsNeeded: 0
    storyOrder: 5
  journal: {fileID: 11400000, guid: c8fe83c5587070442976072e0cbb9051, type: 2}
  words:
  - id: ko_hagwon
    english: "\uD559\uC6D0"
    meaning: academy, cram school
    partOfSpeech: n
    example: "\uC62C\uBD04\uC5D0 \uB098\uB294 \uD559\uC6D0\uC744 \uC878\uC5C5\uD55C\uB2E4."
    exampleMeaning: I will graduate from the academy this spring.
    story: 1
    storyHeading: "\uCD9C\uBC1C \uC804"
    romanization: hagwon
  - id: ko_beop
    english: "\uBC95"
    meaning: law, how to
    partOfSpeech: n
    example: "\uD559\uC6D0\uC740 \uB0B4\uAC8C \uC9C0\uB3C4 \uADF8\uB9AC\uB294 \uBC95\uC744
      \uAC00\uB974\uCCE4\uB2E4."
    exampleMeaning: The academy taught me how to draw maps.
    story: 2
    storyHeading: 
    romanization: beop
  - id: ko_ttwieonada
    english: "\uB6F0\uC5B4\uB098\uB2E4"
    meaning: excellent, outstanding
    partOfSpeech: adj
    example: "\uC99D\uBA85\uC11C\uC5D0\uB294 \uB0B4\uAC00 \uB6F0\uC5B4\uB09C \uC9C0\uB3C4
      \uC81C\uC791\uC790\uB77C\uACE0 \uC801\uD600 \uC788\uB2E4."
    exampleMeaning: My certificate says I am an excellent mapmaker.
    story: 3
    storyHeading: 
    romanization: ttwieonada
  - id: ko_sup
    english: "\uC232"
    meaning: forest
    partOfSpeech: n
    example: "\uBD80\uCC98\uB294 \uD070 \uC232\uC758 \uC9C0\uB3C4\uB97C \uADF8\uB9AC\uB77C\uBA70
      \uB098\uB97C \uBCF4\uB0C8\uB2E4."
    exampleMeaning: The ministry sent me to map the great forest.
    story: 4
    storyHeading: 
    romanization: sup
  - id: ko_immu
    english: "\uC784\uBB34"
    meaning: mission, duty
    partOfSpeech: n
    example: "\uB0B4 \uC784\uBB34\uB294 \uAC04\uB2E8\uD574 \uBCF4\uC600\uB2E4. \uC774\uC815\uD45C\uB97C
      \uC218\uB9AC\uD558\uB294 \uAC83\uC774\uC5C8\uB2E4."
    exampleMeaning: 'My task sounded simple: repair the signposts.'
    story: 5
    storyHeading: 
    romanization: immu
  - id: ko_mopsi
    english: "\uBAB9\uC2DC"
    meaning: very, extremely
    partOfSpeech: adv
    example: "\uC6B0\uB9AC \uD300\uC740 \uB2E4\uC12F \uBA85\uACFC \uBAB9\uC2DC \uC2EC\uC220\uAD82\uC740
      \uB178\uC0C8 \uD55C \uB9C8\uB9AC\uB85C \uC774\uB8E8\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    exampleMeaning: My crew consisted of five people and one very angry mule.
    story: 6
    storyHeading: 
    romanization: mopsi
  - id: ko_jangbi
    english: "\uC7A5\uBE44"
    meaning: equipment
    partOfSpeech: n
    example: "\uB098\uB294 \uD39C\uACFC \uBC27\uC904, \uBE44\uC2A4\uD0B7\uC73C\uB85C
      \uD544\uC694\uD55C \uC7A5\uBE44\uB97C \uBE60\uC9D0\uC5C6\uC774 \uCC59\uACBC\uB2E4."
    exampleMeaning: I packed a complete kit of pens, rope, and biscuits.
    story: 7
    storyHeading: 
    romanization: jangbi
  - id: ko_boheom
    english: "\uBCF4\uD5D8"
    meaning: insurance
    partOfSpeech: n
    example: "\uBD80\uCC98\uB294 \uB0B4 \uBCF4\uD5D8\uB8CC\uB97C \uB0B4\uC8FC\uC9C0
      \uC54A\uC558\uB2E4."
    exampleMeaning: The ministry refused to pay my insurance premium.
    story: 8
    storyHeading: 
    romanization: boheom
  - id: ko_jeomsim
    english: "\uC810\uC2EC"
    meaning: lunch
    partOfSpeech: n
    example: "\uC548\uAC74\uC758 \uCCAB \uD56D\uBAA9\uC740 \uC810\uC2EC\uC774\uC5C8\uB2E4."
    exampleMeaning: The first item on the agenda was lunch.
    story: 9
    storyHeading: 
    romanization: jeomsim
  - id: ko_yaksok
    english: "\uC57D\uC18D"
    meaning: promise
    partOfSpeech: n
    example: "\uBCF8\uBD80\uB294 \uC77C\uC8FC\uC77C\uC774\uBA74 \uC9D1\uC5D0 \uB3CC\uC544\uC628\uB2E4\uACE0
      \uC57D\uC18D\uD588\uB2E4."
    exampleMeaning: Headquarters promised we would be home in a week.
    story: 10
    storyHeading: 
    romanization: yaksok
  - id: ko_japda
    english: "\uC7A1\uB2E4"
    meaning: to catch, to grab
    partOfSpeech: v
    example: "\uAC04\uBD80 \uD55C \uC0AC\uB78C\uC774 \uB0B4 \uC190\uC744 \uC7A1\uB354\uB2C8
      \uC774\uB984\uC744 \uC78A\uC5C8\uB2E4."
    exampleMeaning: An executive shook my hand and forgot my name.
    story: 11
    storyHeading: 
    romanization: japda
  - id: ko_ttaragada
    english: "\uB530\uB77C\uAC00\uB2E4"
    meaning: to follow (along)
    partOfSpeech: v
    example: "\uC232\uC73C\uB85C \uC774\uC5B4\uC9C0\uB294 \uC624\uC194\uAE38\uC740
      \uB113\uACE0 \uB530\uB77C\uAC00\uAE30 \uC26C\uC6E0\uB2E4."
    exampleMeaning: The trail into the forest was wide and easy to follow.
    story: 12
    storyHeading: "1\uC77C\uC9F8"
    romanization: ttaragada
  - id: ko_pureuda
    english: "\uD478\uB974\uB2E4"
    meaning: blue, green
    partOfSpeech: adj
    example: "\uD48D\uACBD\uC740 \uB208\uC774 \uC544\uD50C \uC815\uB3C4\uB85C \uC628\uD1B5
      \uD478\uB974\uB800\uB2E4."
    exampleMeaning: The landscape was so green that it almost hurt my eyes.
    story: 13
    storyHeading: 
    romanization: pureuda
  - id: ko_sigol
    english: "\uC2DC\uACE8"
    meaning: countryside
    partOfSpeech: n
    example: "\uC815\uC624\uC5D0 \uB9C8\uC9C0\uB9C9 \uC2DC\uACE8 \uB18D\uC7A5\uC744
      \uC9C0\uB098\uCCE4\uB2E4."
    exampleMeaning: We left the last rural farm behind at noon.
    story: 14
    storyHeading: 
    romanization: sigol
  - id: ko_dol
    english: "\uB3CC"
    meaning: stone
    partOfSpeech: n
    example: "\uB3CC \uD558\uB098\uAC00 \uC232\uC758 \uACBD\uACC4\uB97C \uD45C\uC2DC\uD558\uACE0
      \uC788\uC5C8\uB2E4."
    exampleMeaning: A stone marked the border of the forest.
    story: 15
    storyHeading: 
    romanization: dol
  - id: ko_geulja
    english: "\uAE00\uC790"
    meaning: character (written)
    partOfSpeech: n
    example: "\uD45C\uC9C0\uD310\uC5D0\uB294 \uCD9C\uC785 \uAE08\uC9C0\uB77C\uACE0
      \uC801\uD600 \uC788\uC5C8\uC9C0\uB9CC \uAE00\uC790\uB4E4\uC774 \uB4A4\uC8FD\uBC15\uC8FD\uC774\uC5C8\uB2E4."
    exampleMeaning: The sign said no entry, but the letters were all jumbled.
    story: 16
    storyHeading: 
    romanization: geulja
  - id: ko_jeonyeok
    english: "\uC800\uB141"
    meaning: evening
    partOfSpeech: n
    example: "\uC800\uB141\uC774 \uB418\uC790 \uAE38\uC774 \uB354\uB294 \uBCF4\uC774\uC9C0
      \uC54A\uC558\uB2E4."
    exampleMeaning: By evening, the road was no longer visible.
    story: 17
    storyHeading: 
    romanization: jeonyeok
  - id: ko_nota
    english: "\uB193\uB2E4"
    meaning: to put, to place
    partOfSpeech: v
    example: "\uC774\uC815\uD45C\uB4E4\uC774 \uC774\uC0C1\uD588\uB2E4. \uB204\uAC00
      \uC62E\uACA8 \uB193\uC740 \uAC83 \uAC19\uC558\uB2E4."
    exampleMeaning: The signposts looked weird, as if someone had moved them.
    story: 18
    storyHeading: 
    romanization: nota
  - id: ko_banghyang
    english: "\uBC29\uD5A5"
    meaning: direction
    partOfSpeech: n
    example: "\uC774\uC815\uD45C\uB9C8\uB2E4 \uBB34\uC791\uC704 \uBC29\uD5A5\uC744
      \uAC00\uB9AC\uCF30\uB2E4."
    exampleMeaning: Every signpost pointed in a random direction.
    story: 19
    storyHeading: 
    romanization: banghyang
  - id: ko_sigan
    english: "\uC2DC\uAC04"
    meaning: hour, time
    partOfSpeech: n
    example: "\uB0B4 \uC9C0\uB3C4\uB294 \uD55C \uC2DC\uAC04\uCBE4 \uC815\uD655\uD588\uB2E4."
    exampleMeaning: My map was accurate for about one hour.
    story: 20
    storyHeading: 
    romanization: sigan
  - id: ko_saheul
    english: "\uC0AC\uD758"
    meaning: three days
    partOfSpeech: n
    example: "\uC0AC\uD758\uC9F8\uAC00 \uB418\uC790 \uC6B0\uB9AC \uD300\uC740 \uD63C\uB780\uC5D0
      \uBE60\uC84C\uB2E4."
    exampleMeaning: By the third day, the crew was in chaos.
    story: 21
    storyHeading: "3\uC77C\uC9F8"
    romanization: saheul
  - id: ko_bukjjok
    english: "\uBD81\uCABD"
    meaning: north
    partOfSpeech: n
    example: "\uC5B4\uB290 \uCABD\uC774 \uBD81\uCABD\uC778\uC9C0\uB97C \uB450\uACE0
      \uB17C\uC7C1\uC774 \uBC8C\uC5B4\uC84C\uB2E4."
    exampleMeaning: A dispute broke out over which direction was north.
    story: 22
    storyHeading: 
    romanization: bukjjok
  - id: ko_eodi
    english: "\uC5B4\uB514"
    meaning: where
    partOfSpeech: n
    example: "\uD22C\uD45C\uB97C \uD588\uB2E4. \uBD81\uCABD\uC774 \uC774\uACBC\uC9C0\uB9CC,
      \uC815\uC791 \uBD81\uCABD\uC774 \uC5B4\uB514\uC778\uC9C0\uB294 \uC544\uBB34\uB3C4
      \uBAB0\uB790\uB2E4."
    exampleMeaning: We held a poll. North won, but nobody knew where it was.
    story: 23
    storyHeading: 
    romanization: eodi
  - id: ko_simgakada
    english: "\uC2EC\uAC01\uD558\uB2E4"
    meaning: serious
    partOfSpeech: adj
    example: "\uBE44\uC2A4\uD0B7 \uB54C\uBB38\uC5D0 \uC2EC\uAC01\uD55C \uB17C\uB780\uC774
      \uBC8C\uC5B4\uC84C\uB2E4."
    exampleMeaning: The biscuits caused a serious controversy.
    story: 24
    storyHeading: 
    romanization: simgakada
  - id: ko_nanuda
    english: "\uB098\uB204\uB2E4"
    meaning: to divide, to share
    partOfSpeech: v
    example: "\uB9C8\uC9C0\uB9C9 \uBE44\uC2A4\uD0B7\uC744 \uC5EC\uC12F \uC870\uAC01\uC73C\uB85C
      \uB098\uB204\uAE30\uB85C \uD588\uB2E4."
    exampleMeaning: We decided to split the last biscuit into six pieces.
    story: 25
    storyHeading: 
    romanization: nanuda
  - id: ko_meokda
    english: "\uBA39\uB2E4"
    meaning: to eat
    partOfSpeech: v
    example: "\uB178\uC0C8\uAC00 \uB0B4 \uBAAB\uC744 \uBA39\uC5C8\uB2E4."
    exampleMeaning: The mule ate my portion.
    story: 26
    storyHeading: 
    romanization: meokda
  - id: ko_jurida
    english: "\uC904\uC774\uB2E4"
    meaning: to reduce
    partOfSpeech: v
    example: "\uB098\uB294 \uBA39\uB294 \uC591\uC740 \uCD5C\uB300\uD55C \uC904\uC774\uACE0,
      \uAE30\uB85D\uC740 \uCD5C\uB300\uD55C \uB9CE\uC774 \uD55C\uB2E4."
    exampleMeaning: I eat the minimum I can and write as much as possible.
    story: 27
    storyHeading: 
    romanization: jurida
  - id: ko_singyeong
    english: "\uC2E0\uACBD"
    meaning: nerves
    partOfSpeech: n
    example: "\uB098\uB294 \uBE44\uC0C1\uC0AC\uD0DC\uB97C \uC120\uC5B8\uD588\uC9C0\uB9CC,
      \uB178\uC0C8\uB294 \uC2E0\uACBD\uB3C4 \uC4F0\uC9C0 \uC54A\uC558\uB2E4."
    exampleMeaning: I declared an emergency, but the mule did not care.
    story: 28
    storyHeading: 
    romanization: singyeong
  - id: ko_bogoseo
    english: "\uBCF4\uACE0\uC11C"
    meaning: report
    partOfSpeech: n
    example: "\uC774\uC81C \uC774 \uC77C\uC9C0\uAC00 \uB0B4 \uC720\uC77C\uD55C \uACF5\uC2DD
      \uBCF4\uACE0\uC11C\uB2E4."
    exampleMeaning: This journal is now my only official report.
    story: 29
    storyHeading: 
    romanization: bogoseo
  - id: ko_jechulhada
    english: "\uC81C\uCD9C\uD558\uB2E4"
    meaning: to submit
    partOfSpeech: v
    example: "\uC9D1\uC5D0 \uAC08 \uAE38\uC744 \uCC3E\uC73C\uBA74 \uC81C\uCD9C\uD560
      \uAC83\uC774\uB2E4."
    exampleMeaning: I will submit it when I find a way home.
    story: 30
    storyHeading: 
    romanization: jechulhada
  - id: ko_barada
    english: "\uBC14\uB77C\uB2E4"
    meaning: to hope, to wish
    partOfSpeech: v
    example: "\uC774\uAC74 \uCD08\uC548\uC77C \uBFD0\uC774\uB2C8 \uC9C4\uD759 \uC5BC\uB8E9\uC740
      \uC591\uD574\uD574 \uC8FC\uAE38 \uBC14\uB780\uB2E4."
    exampleMeaning: This is only a draft, so please excuse the mud stains.
    story: 31
    storyHeading: 
    romanization: barada
  - id: ko_matchuda
    english: "\uB9DE\uCD94\uB2E4"
    meaning: to fit, to match
    partOfSpeech: v
    example: "\uC815\uBD80 \uBD80\uCC98\uB294 \uC774\uB7F0 \uACF3\uC5D0\uC11C\uB3C4
      \uBCF4\uACE0\uC11C\uB97C \uC815\uD574\uC9C4 \uD615\uC2DD\uC5D0 \uB9DE\uCD94\uAE38
      \uC6D0\uD55C\uB2E4."
    exampleMeaning: The ministry still wants the report in the proper format, even
      out here.
    story: 32
    storyHeading: 
    romanization: matchuda
  - id: ko_honja
    english: "\uD63C\uC790"
    meaning: alone
    partOfSpeech: n
    example: "\uD63C\uC790 \uB2AA\uC744 \uD0D0\uD5D8\uD558\uB7EC \uAC14\uB2E4."
    exampleMeaning: I went to explore the swamp alone.
    story: 33
    storyHeading: "7\uC77C\uC9F8"
    romanization: honja
  - id: ko_samda
    english: "\uC0B6\uB2E4"
    meaning: to boil
    partOfSpeech: v
    example: "\uC800\uB141\uC740 \uC774\uB984\uB3C4 \uBAA8\uB974\uB294 \uC7A1\uCD08\uB97C
      \uC0B6\uC740 \uAC83\uC774\uC5C8\uB2E4."
    exampleMeaning: Dinner was a boiled weed whose name I didn't know.
    story: 34
    storyHeading: 
    romanization: samda
  - id: ko_silsu
    english: "\uC2E4\uC218"
    meaning: mistake
    partOfSpeech: n
    example: "\uC544\uCE68\uC740 \uB0A0 \uBC84\uC12F\uC774\uC5C8\uACE0, \uADF8\uAC74
      \uC2E4\uC218\uC600\uB2E4."
    exampleMeaning: Breakfast was a raw mushroom, which was a mistake.
    story: 35
    storyHeading: 
    romanization: silsu
  - id: ko_ssipda
    english: "\uC539\uB2E4"
    meaning: to chew
    partOfSpeech: v
    example: "\uC904\uAE30\uB97C \uC539\uC5C8\uB354\uB2C8 \uD55C \uC2DC\uAC04 \uB3D9\uC548
      \uB2EC\uC774 \uC138 \uAC1C\uB85C \uBCF4\uC600\uB2E4."
    exampleMeaning: I chewed a stem and saw three moons for an hour.
    story: 36
    storyHeading: 
    romanization: ssipda
  - id: ko_mat
    english: "\uB9DB"
    meaning: taste
    partOfSpeech: n
    example: "\uB2AA\uC758 \uBB3C\uC740 \uC5ED\uACA8\uC6B4 \uB9DB\uC774 \uB09C\uB2E4."
    exampleMeaning: The swamp water tastes gross.
    story: 37
    storyHeading: 
    romanization: mat
  - id: ko_geomda
    english: "\uAC80\uB2E4"
    meaning: black
    partOfSpeech: adj
    example: "\uAC80\uC740 \uC561\uCCB4\uB97C \uB9C8\uC2DC\uACE0\uB3C4 \uC0B4\uC544\uB0A8\uC558\uB2E4."
    exampleMeaning: I drank a black liquid and lived.
    story: 38
    storyHeading: 
    romanization: geomda
  - id: ko_kkaekkeutada
    english: "\uAE68\uB057\uD558\uB2E4"
    meaning: clean
    partOfSpeech: adj
    example: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB0A8\uC740 \uAE68\uB057\uD55C \uC591\uB9D0\uB85C
      \uC5EC\uACFC\uAE30\uB97C \uB9CC\uB4E4\uC5C8\uB2E4."
    exampleMeaning: I made a filter out of my last clean sock.
    story: 39
    storyHeading: 
    romanization: kkaekkeutada
  - id: ko_masida
    english: "\uB9C8\uC2DC\uB2E4"
    meaning: to drink
    partOfSpeech: v
    example: "\uC18D \uBE48 \uAC08\uB300\uB294 \uB9C8\uC2DC\uAE30 \uC88B\uC740 \uAD00\uC774
      \uB41C\uB2E4."
    exampleMeaning: A hollow reed makes a good tube for drinking.
    story: 40
    storyHeading: 
    romanization: masida
  - id: ko_jeotda
    english: "\uC816\uB2E4"
    meaning: to get wet
    partOfSpeech: v
    example: "\uC816\uC740 \uB098\uBB34\uB294 \uD615\uD3B8\uC5C6\uB294 \uC5F0\uB8CC\uC9C0\uB9CC
      \uC61B \uBCF4\uACE0\uC11C\uB294 \uC798 \uD0C4\uB2E4."
    exampleMeaning: Wet wood is poor fuel, but my old reports burn well.
    story: 41
    storyHeading: 
    romanization: jeotda
  - id: ko_nappeuda
    english: "\uB098\uC058\uB2E4"
    meaning: bad
    partOfSpeech: adj
    example: "\uAC00\uC8FD \uC7A5\uD654\uB97C \uC870\uAE08 \uBA39\uC5C8\uB2E4. \uB098\uC058\uC9C0
      \uC54A\uC558\uB2E4."
    exampleMeaning: I ate part of my leather boot. It was not bad.
    story: 42
    storyHeading: 
    romanization: nappeuda
  - id: ko_amugeot
    english: "\uC544\uBB34\uAC83"
    meaning: anything
    partOfSpeech: n
    example: "\uD39C\uC744 \uAD6C\uBD80\uB824 \uAC08\uACE0\uB9AC\uB97C \uB9CC\uB4E4\uC5C8\uC9C0\uB9CC
      \uC544\uBB34\uAC83\uB3C4 \uBABB \uC7A1\uC558\uB2E4."
    exampleMeaning: I bent a hook from my pen and caught nothing.
    story: 43
    storyHeading: 
    romanization: amugeot
  - id: ko_ppaeda
    english: "\uBE7C\uB2E4"
    meaning: to take out, to remove
    partOfSpeech: v
    example: "\uBAA8\uC790\uC5D0\uC11C \uBE80 \uC2E4\uB85C \uC678\uD22C\uB97C \uAFF0\uB9F8\uB2E4."
    exampleMeaning: I sewed my coat with thread from my hat.
    story: 44
    storyHeading: 
    romanization: ppaeda
  - id: ko_mukda
    english: "\uBB36\uB2E4"
    meaning: to tie
    partOfSpeech: v
    example: "\uC774\uC81C \uC9C0\uB098\uB294 \uB098\uBB34\uB9C8\uB2E4 \uCC9C \uC870\uAC01\uC744
      \uBB36\uC5B4 \uD45C\uC2DC\uD55C\uB2E4."
    exampleMeaning: A strip of cloth now marks each tree I pass.
    story: 45
    storyHeading: 
    romanization: mukda
  - id: ko_dalda
    english: "\uB2EC\uB2E4"
    meaning: to hang, to attach
    partOfSpeech: v
    example: "\uB178\uC0C8\uC5D0 \uAF2C\uB9AC\uD45C\uB97C \uB2EC\uC558\uB2E4. \uB0B4
      \uBCF4\uACE0\uC11C\uB97C \uBA39\uC9C0 \uB9D0 \uAC83."
    exampleMeaning: 'I put a tag on the mule: do not eat my report.'
    story: 46
    storyHeading: 
    romanization: dalda
  - id: ko_beonho
    english: "\uBC88\uD638"
    meaning: number (ID)
    partOfSpeech: n
    example: "\uB3CC\uC544\uAC00\uB294 \uAE38\uC744 \uCC3E\uC744 \uC218 \uC788\uB3C4\uB85D
      \uB098\uBB34\uC5D0 \uCC28\uB840\uB300\uB85C \uBC88\uD638\uB97C \uB9E4\uAE34\uB2E4."
    exampleMeaning: I number the trees in sequence so I can find my way back.
    story: 47
    storyHeading: 
    romanization: beonho
  - id: ko_gandanhada
    english: "\uAC04\uB2E8\uD558\uB2E4"
    meaning: simple
    partOfSpeech: adj
    example: "\uB0B4 \uC77C\uACFC\uB294 \uAC04\uB2E8\uD558\uB2E4. \uAC77\uACE0, \uBA39\uACE0,
      \uC4F0\uACE0, \uAE38\uC744 \uC783\uB294\uB2E4."
    exampleMeaning: 'My routine is simple: walk, eat, write, and get lost.'
    story: 48
    storyHeading: 
    romanization: gandanhada
  - id: ko_georeum
    english: "\uAC78\uC74C"
    meaning: step
    partOfSpeech: n
    example: "\uAC78\uC74C\uC744 \uC138\uB2E4\uAC00 \uC22B\uC790\uB97C \uC78A\uC5B4\uBC84\uB9B0\uB2E4."
    exampleMeaning: I count each pace, and then I forget the number.
    story: 49
    storyHeading: 
    romanization: georeum
  - id: ko_boida
    english: "\uBCF4\uC774\uB2E4"
    meaning: to be seen, to look
    partOfSpeech: v
    example: "\uC774 \uAC01\uB3C4\uC5D0\uC11C\uB294 \uB098\uBB34\uAC00 \uB2E4 \uB611\uAC19\uC544
      \uBCF4\uC778\uB2E4."
    exampleMeaning: From this angle, every tree looks the same.
    story: 50
    storyHeading: 
    romanization: boida
  - id: ko_soyongeopda
    english: "\uC18C\uC6A9\uC5C6\uB2E4"
    meaning: useless
    partOfSpeech: adj
    example: "\uB098\uBB34\uB97C \uC804\uBD80 \uC0C9\uC778\uC73C\uB85C \uB9CC\uB4E4\uC5C8\uB2E4.
      \uC18C\uC6A9\uC5C6\uC5C8\uB2E4."
    exampleMeaning: I made an index of all the trees. It did not help.
    story: 51
    storyHeading: 
    romanization: soyongeopda
  - id: ko_akkida
    english: "\uC544\uB07C\uB2E4"
    meaning: to save, to spare
    partOfSpeech: v
    example: "\uC885\uC774\uB97C \uC544\uB07C\uB824\uACE0 \uC5EC\uBC31\uC5D0 \uC4F4\uB2E4."
    exampleMeaning: I write in the margin to save paper.
    story: 52
    storyHeading: 
    romanization: akkida
  - id: ko_jido
    english: "\uC9C0\uB3C4"
    meaning: map
    partOfSpeech: n
    example: "\uC9C0\uB3C4\uB97C \uAC31\uC2E0\uD55C\uB2E4. \uC6B0\uB9AC\uB294 \uAE38\uC744
      \uC783\uC5C8\uB2E4."
    exampleMeaning: 'Let me update the map: we are lost.'
    story: 53
    storyHeading: 
    romanization: jido
  - id: ko_majuchida
    english: "\uB9C8\uC8FC\uCE58\uB2E4"
    meaning: to run into
    partOfSpeech: v
    example: "\uC774\uC815\uD45C\uB97C \uB4E0 \uB108\uAD6C\uB9AC\uB97C \uB9C8\uC8FC\uCE60
      \uC904\uC740 \uBAB0\uB790\uB2E4."
    exampleMeaning: I did not expect to encounter a raccoon with a signpost.
    story: 54
    storyHeading: "12\uC77C\uC9F8"
    romanization: majuchida
  - id: ko_geokkuro
    english: "\uAC70\uAFB8\uB85C"
    meaning: backward, upside down
    partOfSpeech: adv
    example: "\uB108\uAD6C\uB9AC\uB294 \uD45C\uC9C0\uD310\uC744 \uAC70\uAFB8\uB85C
      \uB3CC\uB824\uB193\uACE0 \uB098\uB97C \uBE44\uC6C3\uC5C8\uB2E4."
    exampleMeaning: It would reverse every sign and laugh at me.
    story: 55
    storyHeading: 
    romanization: geokkuro
  - id: ko_jeonbu
    english: "\uC804\uBD80"
    meaning: all, everything
    partOfSpeech: n
    example: "\uC6B0\uB9AC\uB97C \uACC4\uC18D \uB9F4\uB3CC\uAC8C \uD558\uB294 \uAC83\uC774
      \uADF8 \uACC4\uB7B5\uC758 \uC804\uBD80\uC600\uB2E4."
    exampleMeaning: Its whole scheme was to keep us walking in circles.
    story: 56
    storyHeading: 
    romanization: jeonbu
  - id: ko_ama
    english: "\uC544\uB9C8"
    meaning: maybe, probably
    partOfSpeech: adv
    example: "\uC74C\uBAA8\uAC00 \uC788\uB294 \uAC83 \uAC19\uB2E4. \uC544\uB9C8 \uB108\uAD6C\uB9AC\uAC00
      \uAFB8\uBBFC."
    exampleMeaning: I suspect a plot, possibly by the raccoon.
    story: 57
    storyHeading: 
    romanization: ama
  - id: ko_beoseot
    english: "\uBC84\uC12F"
    meaning: mushroom
    partOfSpeech: n
    example: "\uBC84\uC12F \uBB34\uB9AC\uAC00 \uAE38\uC744 \uB9C9\uC558\uB2E4."
    exampleMeaning: A gang of mushrooms blocked the path.
    story: 58
    storyHeading: 
    romanization: beoseot
  - id: ko_tteuda
    english: "\uB728\uB2E4"
    meaning: to float
    partOfSpeech: v
    example: "\uB208\uC5D0 \uBB3C\uC74C\uD45C\uAC00 \uB72C \uC9D0\uC2B9\uC774 \uB098\uB97C
      \uCCD0\uB2E4\uBD24\uB2E4."
    exampleMeaning: A beast with question marks in its eyes stared at me.
    story: 59
    storyHeading: 
    romanization: tteuda
  - id: ko_goemul
    english: "\uAD34\uBB3C"
    meaning: monster
    partOfSpeech: n
    example: "\uB2E4\uB978 \uAD34\uBB3C\uC740 \uB0B4 \uC774\uB984\uC758 \uCCA0\uC790\uB97C
      \uB300 \uBCF4\uB77C\uACE0 \uD588\uB2E4."
    exampleMeaning: Another monster asked me to spell my own name.
    story: 60
    storyHeading: 
    romanization: goemul
  - id: ko_baem
    english: "\uBC40"
    meaning: snake
    partOfSpeech: n
    example: "\uB9E4\uB4ED\uC9C4 \uBC40\uACFC\uC758 \uC804\uD22C\uB294 \uC544\uC8FC
      \uD5F7\uAC08\uB9B0\uB2E4."
    exampleMeaning: Combat with a snake in a knot is very confusing.
    story: 61
    storyHeading: 
    romanization: baem
  - id: ko_ja
    english: "\uC790"
    meaning: ruler (for measuring)
    partOfSpeech: n
    example: "\uC790\uB85C \uB098\uB97C \uBC29\uC5B4\uD558\uB824 \uD588\uB2E4."
    exampleMeaning: I tried to defend myself with a ruler.
    story: 62
    storyHeading: 
    romanization: ja
  - id: ko_igida
    english: "\uC774\uAE30\uB2E4"
    meaning: to win
    partOfSpeech: v
    example: "\uC790\uB85C\uB294 \uBC40\uC744 \uC774\uAE38 \uC218 \uC5C6\uB2E4."
    exampleMeaning: A ruler cannot defeat a snake.
    story: 63
    storyHeading: 
    romanization: igida
  - id: ko_swipda
    english: "\uC27D\uB2E4"
    meaning: easy
    partOfSpeech: adj
    example: "\uB2EC\uB9AC \uACC4\uD68D\uC774 \uC5C6\uC73C\uBA74 \uC6A9\uAE30\uB294
      \uC27D\uB2E4."
    exampleMeaning: Courage is easy when you have no other plan.
    story: 64
    storyHeading: 
    romanization: swipda
  - id: ko_sseureojida
    english: "\uC4F0\uB7EC\uC9C0\uB2E4"
    meaning: to collapse, to fall down
    partOfSpeech: v
    example: "\uD3EC\uC790 \uB3CC\uD48D\uC5D0 \uB098\uB294 \uB0A9\uC791\uD558\uAC8C
      \uC4F0\uB7EC\uC84C\uB2E4."
    exampleMeaning: A blast of spores knocked me flat.
    story: 65
    storyHeading: 
    romanization: sseureojida
  - id: ko_chunggyeok
    english: "\uCDA9\uACA9"
    meaning: shock
    partOfSpeech: n
    example: "\uADF8 \uCDA9\uACA9\uC73C\uB85C \uC2E0\uBC1C\uC774\uB77C\uB294 \uB9D0\uC744
      \uC78A\uC5C8\uB2E4."
    exampleMeaning: The impact made me forget the word for shoe.
    story: 66
    storyHeading: 
    romanization: chunggyeok
  - id: ko_buran
    english: "\uBD88\uC548"
    meaning: anxiety
    partOfSpeech: n
    example: "\uB9D0\uC744 \uC783\uC744 \uB54C\uB9C8\uB2E4 \uBD88\uC548\uC774 \uCEE4\uC9C4\uB2E4."
    exampleMeaning: My anxiety grows with every word I lose.
    story: 67
    storyHeading: 
    romanization: buran
  - id: ko_jeolban
    english: "\uC808\uBC18"
    meaning: half
    partOfSpeech: n
    example: "\uB0B4 \uBCF4\uACE0\uC11C\uB97C \uC77D\uACE0 \uACF5\uD3EC\uC5D0 \uB5A8\uC5C8\uB2E4.
      \uC808\uBC18\uC774 \uC0AC\uB77C\uC84C\uB2E4."
    exampleMeaning: 'I read my own report with horror: half was gone.'
    story: 68
    storyHeading: 
    romanization: jeolban
  - id: ko_umjigida
    english: "\uC6C0\uC9C1\uC774\uB2E4"
    meaning: to move
    partOfSpeech: v
    example: "\uAE00\uC790\uB4E4\uC774 \uC6C0\uC9C1\uC774\uACE0 \uC788\uB294 \uAC83\uC774
      \uBA85\uBC31\uD588\uB2E4."
    exampleMeaning: It was apparent that the letters were moving.
    story: 69
    storyHeading: 
    romanization: umjigida
  - id: ko_bakkwida
    english: "\uBC14\uB00C\uB2E4"
    meaning: to be changed
    partOfSpeech: v
    example: "\uD55C \uAD6C\uC808\uC740 \uC77D\uC744 \uB54C\uB9C8\uB2E4 \uBC14\uB00C\uC5C8\uB2E4."
    exampleMeaning: One phrase kept changing each time I read it.
    story: 70
    storyHeading: 
    romanization: bakkwida
  - id: ko_tonghada
    english: "\uD1B5\uD558\uB2E4"
    meaning: to get through, to make sense
    partOfSpeech: v
    example: "\uC774 \uC232\uC5D0\uC11C\uB294 \uB17C\uB9AC\uAC00 \uD1B5\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    exampleMeaning: Logic does not work in this forest.
    story: 71
    storyHeading: 
    romanization: tonghada
  - id: ko_mitda
    english: "\uBBFF\uB2E4"
    meaning: to believe
    partOfSpeech: v
    example: "\uBBFF\uC740 \uAE38\uC740 \uBAA8\uB450 \uAC70\uC9D3\uC774\uC5C8\uB2E4."
    exampleMeaning: Every path I trust turns out to be false.
    story: 72
    storyHeading: 
    romanization: mitda
  - id: ko_jeunggeo
    english: "\uC99D\uAC70"
    meaning: evidence
    partOfSpeech: n
    example: "\uC9C4\uD759 \uBB3B\uC740 \uC7A5\uD654\uB9CC\uC774 \uB0B4\uAC00 \uAC78\uC5C8\uB2E4\uB294
      \uC720\uC77C\uD55C \uC99D\uAC70\uB2E4."
    exampleMeaning: My muddy boots are my only proof I walked at all.
    story: 73
    storyHeading: 
    romanization: jeunggeo
  - id: ko_sogeum
    english: "\uC18C\uAE08"
    meaning: salt
    partOfSpeech: n
    example: "\uC18C\uAE08\uC740 \uD544\uC218\uB2E4. \uB9D0\uB3C4 \uADF8\uB807\uB2E4\uB294
      \uAC78 \uC54C\uC558\uB2E4."
    exampleMeaning: Salt is vital. So are words, it turns out.
    story: 74
    storyHeading: "20\uC77C\uC9F8"
    romanization: sogeum
  - id: ko_gyuchik
    english: "\uADDC\uCE59"
    meaning: rule
    partOfSpeech: n
    example: "\uADFC\uBCF8\uC801\uC778 \uADDC\uCE59. \uC719\uD06C\uD558\uB294 \uAC83\uC740
      \uBA39\uC9C0 \uB9D0 \uAC83."
    exampleMeaning: 'A fundamental rule: never eat what winks at you.'
    story: 75
    storyHeading: 
    romanization: gyuchik
  - id: ko_anda
    english: "\uC549\uB2E4"
    meaning: to sit
    partOfSpeech: v
    example: "\uCD94\uC704\uAC00 \uC2EC\uD588\uACE0, \uB178\uC0C8\uAC00 \uB0B4 \uC704\uC5D0
      \uC549\uC558\uB2E4."
    exampleMeaning: The cold was severe, and the mule sat on me.
    story: 76
    storyHeading: 
    romanization: anda
  - id: ko_geu
    english: "\uADF8"
    meaning: that
    partOfSpeech: adj
    example: "\uC6B0\uB9AC\uB294 \uADF8 \uBC24\uC744 \uC218\uD504 \uC7AC\uB09C\uC774\uB77C
      \uBD80\uB978\uB2E4."
    exampleMeaning: We call that night the disaster of the soup.
    story: 77
    storyHeading: 
    romanization: geu
  - id: ko_dollida
    english: "\uB3CC\uB9AC\uB2E4"
    meaning: to turn
    partOfSpeech: v
    example: "\uC694\uB9AC\uC0AC\uB294 \uADF8 \uC0AC\uAC74\uC744 \uB108\uAD6C\uB9AC
      \uD0D3\uC73C\uB85C \uB3CC\uB9B0\uB2E4."
    exampleMeaning: The cook blames the incident on the raccoon.
    story: 78
    storyHeading: 
    romanization: dollida
  - id: ko_chimmuk
    english: "\uCE68\uBB35"
    meaning: silence
    partOfSpeech: n
    example: "\uB9D0\uB4E4\uC774 \uC0AC\uB77C\uC9C0\uC790 \uC232\uC740 \uCE68\uBB35\uC5D0
      \uC7A0\uACBC\uB2E4."
    exampleMeaning: The forest fell silent as the words disappeared.
    story: 79
    storyHeading: 
    romanization: chimmuk
  - id: ko_du
    english: "\uB450"
    meaning: two
    partOfSpeech: adj
    example: "\uC6B0\uB9AC\uB294 \uC7AC\uD310\uC744 \uC5F4\uC5C8\uB2E4. \uBC30\uC2EC\uC6D0\uC740
      \uB450 \uC0AC\uB78C\uACFC \uB178\uC0C8 \uD55C \uB9C8\uB9AC\uC600\uB2E4."
    exampleMeaning: We held a trial. The jury consisted of two men and a mule.
    story: 80
    storyHeading: 
    romanization: du
  - id: ko_ssitda
    english: "\uC53B\uB2E4"
    meaning: to wash
    partOfSpeech: v
    example: "\uBC8C\uCE59\uC740 \uC77C\uC8FC\uC77C \uB3D9\uC548 \uC694\uB9AC \uB0C4\uBE44\uB97C
      \uC53B\uB294 \uAC83\uC774\uC5C8\uB2E4."
    exampleMeaning: The penalty was a week of washing the cooking pot.
    story: 81
    storyHeading: 
    romanization: ssitda
  - id: ko_namutgaji
    english: "\uB098\uBB47\uAC00\uC9C0"
    meaning: branch, twig
    partOfSpeech: n
    example: "\uC6B0\uB9AC\uC758 \uAC10\uC625\uC740 \uB098\uBB47\uAC00\uC9C0\uB85C
      \uB9CC\uB4E0 \uC6D0\uC5D0 \uBD88\uACFC\uD588\uACE0, \uADF8 \uC548\uC5D0 \uBA38\uBB34\uB294
      \uC0AC\uB78C\uC740 \uC544\uBB34\uB3C4 \uC5C6\uC5C8\uB2E4."
    exampleMeaning: Our jail was just a circle of sticks, and nobody stayed inside
      it.
    story: 82
    storyHeading: 
    romanization: namutgaji
  - id: ko_sutgarak
    english: "\uC21F\uAC00\uB77D"
    meaning: spoon
    partOfSpeech: n
    example: "\uB9C8\uC9C0\uB9C9 \uC218\uD504 \uD55C \uC21F\uAC00\uB77D \uB54C\uBB38\uC5D0
      \uD558\uB9C8\uD130\uBA74 \uC0B4\uC778 \uC0AC\uAC74\uC774 \uBC8C\uC5B4\uC9C8
      \uBED4\uD588\uB2E4."
    exampleMeaning: There was almost a murder over the last spoonful of soup.
    story: 83
    storyHeading: 
    romanization: sutgarak
  - id: ko_gapjagi
    english: "\uAC11\uC790\uAE30"
    meaning: suddenly
    partOfSpeech: adv
    example: "\uB178\uC0C8\uAC00 \uB0B4 \uC9C0\uB3C4\uB97C \uAC11\uC790\uAE30 \uACF5\uACA9\uD588\uACE0,
      \uC9C0\uB3C4\uB294 \uC0B0\uC0B0\uC870\uAC01\uC774 \uB0AC\uB2E4."
    exampleMeaning: The mule's assault on my map came without warning and left it
      in pieces.
    story: 84
    storyHeading: 
    romanization: gapjagi
  - id: ko_jujanghada
    english: "\uC8FC\uC7A5\uD558\uB2E4"
    meaning: to claim, to insist
    partOfSpeech: v
    example: "\uB178\uC0C8\uB294 \uC774\uBC88 \uC5EC\uD589\uC774 \uB3D9\uBB3C \uD559\uB300\uB77C\uACE0
      \uC8FC\uC7A5\uD55C\uB2E4. \uB098\uB3C4 \uC778\uC815\uD560 \uC218\uBC16\uC5D0
      \uC5C6\uB2E4."
    exampleMeaning: The mule says this trip is animal abuse. I have to agree.
    story: 85
    storyHeading: 
    romanization: jujanghada
  - id: ko_geonneoda
    english: "\uAC74\uB108\uB2E4"
    meaning: to cross
    partOfSpeech: v
    example: "\uC11C\uB958\uB97C \uC9C0\uD0A4\uB824\uACE0 \uBC8C\uAC70\uBC97\uACE0
      \uAC15\uC744 \uAC74\uB11C\uB2E4."
    exampleMeaning: I crossed the river naked to keep my papers dry.
    story: 86
    storyHeading: 
    romanization: geonneoda
  - id: ko_pi
    english: "\uD53C"
    meaning: blood
    partOfSpeech: n
    example: "\uAC70\uBA38\uB9AC\uAC00 \uD53C\uB97C \uBE68\uAE30 \uB54C\uBB38\uC5D0
      \uC7A5\uD654\uB97C \uBC97\uC9C0 \uC54A\uB294\uB2E4."
    exampleMeaning: Leeches suck blood, so I keep my boots on.
    story: 87
    storyHeading: 
    romanization: pi
  - id: ko_samusil
    english: "\uC0AC\uBB34\uC2E4"
    meaning: office
    partOfSpeech: n
    example: "\uB2E4\uC2DC\uB294 \uC0AC\uBB34\uC2E4 \uC5C5\uBB34\uC5D0 \uB300\uD574
      \uBD88\uD3C9\uD558\uC9C0 \uC54A\uACA0\uB2E4\uACE0 \uB9F9\uC138\uD55C\uB2E4."
    exampleMeaning: I swear I will never complain about office work again.
    story: 88
    storyHeading: 
    romanization: samusil
  - id: ko_seoryu
    english: "\uC11C\uB958"
    meaning: document
    partOfSpeech: n
    example: "\uB0B4 \uC720\uC77C\uD55C \uC8C4\uB294 \uADF8 \uC11C\uB958\uC5D0 \uC11C\uBA85\uD55C
      \uAC83\uC774\uB2E4."
    exampleMeaning: My only sin was signing that form.
    story: 89
    storyHeading: 
    romanization: seoryu
  - id: ko_beoreut
    english: "\uBC84\uB987"
    meaning: habit
    partOfSpeech: n
    example: "\uBE44\uC2A4\uD0B7\uC740 \uB0B4\uAC00 \uC720\uC77C\uD558\uAC8C \uB04A\uC9C0
      \uBABB\uD558\uB294 \uB098\uC05C \uBC84\uB987\uC774\uC5C8\uB2E4."
    exampleMeaning: Biscuits were my one vice.
    story: 90
    storyHeading: 
    romanization: beoreut
  - id: ko_angma
    english: "\uC545\uB9C8"
    meaning: devil, demon
    partOfSpeech: n
    example: "\uB178\uC0C8\uB294 \uC545\uB9C8\uC9C0\uB9CC, \uB0B4 \uC545\uB9C8\uB2E4."
    exampleMeaning: The mule is a devil, but it is my devil.
    story: 91
    storyHeading: 
    romanization: angma
  - id: ko_huhoehada
    english: "\uD6C4\uD68C\uD558\uB2E4"
    meaning: to regret
    partOfSpeech: v
    example: "\uBE44\uC2A4\uD0B7 \uB9D0\uACE0\uB294 \uD6C4\uD68C\uD558\uC9C0 \uC54A\uB294\uB2E4."
    exampleMeaning: I regret nothing but the biscuits.
    story: 92
    storyHeading: 
    romanization: huhoehada
  - id: ko_daehada
    english: "\uB300\uD558\uB2E4"
    meaning: to treat, to face
    partOfSpeech: v
    example: "\uB108\uAD6C\uB9AC\uC5D0 \uB300\uD55C \uB0B4 \uBCF5\uC218\uB294 \uAE38\uACE0
      \uC815\uC911\uD560 \uAC83\uC774\uB2E4."
    exampleMeaning: My revenge on the raccoon will be long and polite.
    story: 93
    storyHeading: 
    romanization: daehada
  - id: ko_natanada
    english: "\uB098\uD0C0\uB098\uB2E4"
    meaning: to appear
    partOfSpeech: v
    example: "\uB2AA \uD558\uB098\uB97C \uADF9\uBCF5\uD558\uBA74 \uB610 \uD558\uB098\uAC00
      \uB098\uD0C0\uB09C\uB2E4."
    exampleMeaning: We overcome one swamp, and another one appears.
    story: 94
    storyHeading: 
    romanization: natanada
  - id: ko_eopsaeda
    english: "\uC5C6\uC560\uB2E4"
    meaning: to get rid of
    partOfSpeech: v
    example: "\uC774 \uC9C4\uD759\uC744 \uC5C6\uC568 \uC218\uAC00 \uC5C6\uB2E4."
    exampleMeaning: I cannot get rid of this mud.
    story: 95
    storyHeading: 
    romanization: eopsaeda
  - id: ko_dakda
    english: "\uB2E6\uB2E4"
    meaning: to wipe, to polish
    partOfSpeech: v
    example: "\uB098\uB294 \uC544\uC9C1\uB3C4 \uC544\uCE68\uB9C8\uB2E4 \uBC30\uC9C0\uB97C
      \uB2E6\uB294\uB2E4."
    exampleMeaning: I still polish my badge every morning.
    story: 96
    storyHeading: 
    romanization: dakda
  - id: ko_gamsahada
    english: "\uAC10\uC0AC\uD558\uB2E4"
    meaning: to thank
    partOfSpeech: v
    example: "\uB9C8\uB978 \uC591\uB9D0\uC5D0 \uAC10\uC0AC\uD55C\uB2E4. \uAC00\uC7A5
      \uADC0\uD55C \uBCF4\uBB3C\uC774\uB2E4."
    exampleMeaning: I am grateful for dry socks, the rarest treasure.
    story: 97
    storyHeading: 
    romanization: gamsahada
  - id: ko_puk
    english: "\uD479"
    meaning: soundly, deeply
    partOfSpeech: adv
    example: "\uC774\uB7F0 \uACF3\uC5D0\uC11C \uD479 \uC790\uB294 \uAC83\uC740 \uC0AC\uCE58\uB2E4."
    exampleMeaning: A good night's sleep is a luxury out here.
    story: 98
    storyHeading: 
    romanization: puk
  - id: ko_gabang
    english: "\uAC00\uBC29"
    meaning: bag
    partOfSpeech: n
    example: "\uB0B4 \uBAA8\uB4E0 \uC7AC\uC0B0\uC774 \uC774\uC81C \uC816\uC740 \uAC00\uBC29
      \uD558\uB098\uC5D0 \uB4E4\uC5B4\uAC04\uB2E4."
    exampleMeaning: All my wealth now fits in one wet bag.
    story: 99
    storyHeading: 
    romanization: gabang
  - id: ko_gohyang
    english: "\uACE0\uD5A5"
    meaning: hometown
    partOfSpeech: n
    example: "\uACE0\uD5A5\uC758 \uC791\uC740 \uB545\uC740 \uB178\uC0C8\uC5D0\uAC8C
      \uB118\uAE34\uB2E4."
    exampleMeaning: My small estate back home can go to the mule.
    story: 100
    storyHeading: 
    romanization: gohyang
  - id: ko_noraehada
    english: "\uB178\uB798\uD558\uB2E4"
    meaning: to sing
    partOfSpeech: v
    example: "\uC6B0\uB9AC \uC9D1\uC5D0\uC11C\uB294 \uC544\uCE68\uB9C8\uB2E4 \uC8FC\uC804\uC790\uAC00
      \uB178\uB798\uD588\uB2E4."
    exampleMeaning: In my household, the kettle sang every morning.
    story: 101
    storyHeading: 
    romanization: noraehada
  - id: ko_neukda
    english: "\uB299\uB2E4"
    meaning: to grow old
    partOfSpeech: v
    example: "\uB299\uC740 \uB098\uBB34\uAC00 \uC774 \uAE38\uC758 \uC218\uD638\uC790\uC778
      \uAC83 \uAC19\uB2E4."
    exampleMeaning: An old tree seems to be the guardian of this path.
    story: 102
    storyHeading: "30\uC77C\uC9F8"
    romanization: neukda
  - id: ko_jinjja
    english: "\uC9C4\uC9DC"
    meaning: the real thing, really
    partOfSpeech: n
    example: "\uADF8 \uCE5C\uC808\uC740 \uC9C4\uC9DC \uAC19\uC558\uB2E4. \uC5F4\uB9E4\uB97C
      \uB5A8\uC5B4\uB728\uB824 \uC8FC\uC5C8\uB2E4."
    exampleMeaning: Its kindness seemed genuine; it dropped me a fruit.
    story: 103
    storyHeading: 
    romanization: jinjja
  - id: ko_yeogi
    english: "\uC5EC\uAE30"
    meaning: here
    partOfSpeech: n
    example: "\uC5EC\uAE30\uAC00 \uB0B4 \uC9C0\uB3C4\uC5D0\uC11C \uAC00\uC7A5 \uC678\uB534
      \uACF3\uC774\uB2E4."
    exampleMeaning: This is the most remote place on my map.
    story: 104
    storyHeading: 
    romanization: yeogi
  - id: ko_haneul
    english: "\uD558\uB298"
    meaning: sky
    partOfSpeech: n
    example: "\uC232 \uC548\uCABD\uC5D0\uB294 \uD558\uB298\uC774 \uC5C6\uB2E4."
    exampleMeaning: The interior of the forest has no sky.
    story: 105
    storyHeading: 
    romanization: haneul
  - id: ko_neomu
    english: "\uB108\uBB34"
    meaning: too (much)
    partOfSpeech: adv
    example: "\uC5B4\uB5A4 \uC9C0\uB3C4\uC5D0 \uB2F4\uAE30\uC5D0\uB3C4 \uB108\uBB34
      \uAD11\uB300\uD558\uB2E4."
    exampleMeaning: It is more vast than any map can hold.
    story: 106
    storyHeading: 
    romanization: neomu
  - id: ko_gipda
    english: "\uAE4A\uB2E4"
    meaning: deep
    partOfSpeech: adj
    example: "\uC774\uC81C \uC6B0\uB9AC\uB294 \uB108\uAD6C\uB9AC\uC758 \uC601\uC5ED
      \uAE4A\uC219\uC774 \uB4E4\uC5B4\uC640 \uC788\uB2E4."
    exampleMeaning: We are deep inside raccoon territory now.
    story: 107
    storyHeading: 
    romanization: gipda
  - id: ko_wiheomhada
    english: "\uC704\uD5D8\uD558\uB2E4"
    meaning: dangerous
    partOfSpeech: adj
    example: "\uC774 \uC9C0\uC5ED\uC744 \uC704\uD5D8\uD558\uB2E4\uACE0 \uD45C\uC2DC\uD588\uB294\uB370,
      \uD45C\uC2DC\uB97C \uC783\uC5B4\uBC84\uB838\uB2E4."
    exampleMeaning: I marked this zone as dangerous, then lost the mark.
    story: 108
    storyHeading: 
    romanization: wiheomhada
  - id: ko_ttang
    english: "\uB545"
    meaning: land, ground
    partOfSpeech: n
    example: "\uC5B4\uB290 \uC9C0\uBC29\uB3C4 \uC774 \uC232\uC744 \uC790\uAE30 \uB545\uC774\uB77C
      \uD558\uC9C0 \uC54A\uB294\uB2E4."
    exampleMeaning: No province claims this forest.
    story: 109
    storyHeading: 
    romanization: ttang
  - id: ko_beomwi
    english: "\uBC94\uC704"
    meaning: range, scope
    partOfSpeech: n
    example: "\uC232\uC774 \uC5B4\uB514\uAE4C\uC9C0\uC778\uC9C0 \uADF8 \uBC94\uC704\uB97C
      \uC544\uBB34\uB3C4 \uBAA8\uB978\uB2E4."
    exampleMeaning: Nobody knows the extent of the forest.
    story: 110
    storyHeading: 
    romanization: beomwi
  - id: ko_gang
    english: "\uAC15"
    meaning: river
    partOfSpeech: n
    example: "\uB098\uBB34 \uC0AC\uC774\uC758 \uD2C8\uC73C\uB85C \uAC15\uC774 \uBCF4\uC600\uB2E4."
    exampleMeaning: Through a gap in the trees, I caught sight of a river.
    story: 111
    storyHeading: 
    romanization: gang
  - id: ko_gyesok
    english: "\uACC4\uC18D"
    meaning: continuously
    partOfSpeech: adv
    example: "\uC544\uBB34\uB3C4 \uC6B0\uB9AC\uB97C \uAD6C\uC870\uD558\uC9C0 \uC54A\uC744
      \uD14C\uB2C8 \uACC4\uC18D \uAC77\uB294\uB2E4."
    exampleMeaning: Nobody will rescue us, so I will keep walking.
    story: 112
    storyHeading: 
    romanization: gyesok
  - id: ko_seungni
    english: "\uC2B9\uB9AC"
    meaning: victory
    partOfSpeech: n
    example: "\uAC15\uC744 \uCC3E\uC740 \uAC83\uC740 \uC2B9\uB9AC\uCC98\uB7FC \uB290\uAEF4\uC84C\uB2E4."
    exampleMeaning: Finding the river felt like victory.
    story: 113
    storyHeading: 
    romanization: seungni
  - id: ko_chukha
    english: "\uCD95\uD558"
    meaning: celebration, congratulations
    partOfSpeech: n
    example: "\uB728\uAC70\uC6B4 \uBB3C\uACFC \uC0B6\uC740 \uC78E\uC73C\uB85C \uCD95\uD558\uD55C\uB2E4."
    exampleMeaning: We celebrate with hot water and a boiled leaf.
    story: 114
    storyHeading: 
    romanization: chukha
  - id: ko_siksa
    english: "\uC2DD\uC0AC"
    meaning: meal
    partOfSpeech: n
    example: "\uC624\uB298\uC740 \uB0B4\uAC00 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB530\uB73B\uD55C
      \uC2DD\uC0AC\uB97C \uD55C \uB0A0\uC758 \uAE30\uB150\uC77C\uC774\uB2E4."
    exampleMeaning: Today is the anniversary of my last hot meal.
    story: 115
    storyHeading: 
    romanization: siksa
  - id: ko_byeonhwa
    english: "\uBCC0\uD654"
    meaning: change
    partOfSpeech: n
    example: "\uC232\uC5D0\uC11C \uC815\uAE00\uB85C\uC758 \uBCC0\uD654\uB294 \uAC11\uC791\uC2A4\uB7FD\uAC8C
      \uC77C\uC5B4\uB0AC\uB2E4."
    exampleMeaning: The transition from forest to jungle happened suddenly.
    story: 116
    storyHeading: "41\uC77C\uC9F8"
    romanization: byeonhwa
  - id: ko_gonggi
    english: "\uACF5\uAE30"
    meaning: air
    partOfSpeech: n
    example: "\uACF5\uAE30\uC5D0\uC11C\uB294 \uC9E0\uB0B4\uC640 \uC2B5\uAE30\uAC00
      \uB4A4\uC11E\uC778 \uBC14\uB2E4 \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    exampleMeaning: The air smelled almost marine, thick with salt and moisture.
    story: 117
    storyHeading: 
    romanization: gonggi
  - id: ko_moeuda
    english: "\uBAA8\uC73C\uB2E4"
    meaning: to gather, to collect
    partOfSpeech: v
    example: "\uC6B0\uB9AC\uB294 \uD1B5\uB098\uBB34\uC640 \uD615\uD3B8\uC5C6\uB294
      \uC0DD\uAC01\uB4E4\uC744 \uBAA8\uC544 \uBC30\uB97C \uB9CC\uB4E4\uC5C8\uB2E4."
    exampleMeaning: We built a vessel out of logs and terrible ideas.
    story: 118
    storyHeading: 
    romanization: moeuda
  - id: ko_saebyeok
    english: "\uC0C8\uBCBD"
    meaning: dawn
    partOfSpeech: n
    example: "\uC0C8\uBCBD\uC5D0 \uBC30\uB97C \uB744\uC6B0\uACE0 \uC798\uB418\uAE30\uB97C
      \uBC14\uB780\uB2E4."
    exampleMeaning: We launch it at dawn and hope for the best.
    story: 119
    storyHeading: 
    romanization: saebyeok
  - id: ko_seunggaek
    english: "\uC2B9\uAC1D"
    meaning: passenger
    partOfSpeech: n
    example: "\uB178\uC0C8\uB294 \uB054\uCC0D\uD55C \uC2B9\uAC1D\uC774\uB2E4."
    exampleMeaning: The mule is a terrible passenger.
    story: 120
    storyHeading: 
    romanization: seunggaek
  - id: ko_heuk
    english: "\uD759"
    meaning: soil, dirt
    partOfSpeech: n
    example: "\uAC15\uC740 \uB113\uC740 \uD759\uD0D5\uBB3C \uB9CC\uC73C\uB85C \uC774\uC5B4\uC84C\uB2E4."
    exampleMeaning: The river opened into a wide gulf of muddy water.
    story: 121
    storyHeading: 
    romanization: heuk
  - id: ko_yangnyeop
    english: "\uC591\uC606"
    meaning: both sides
    partOfSpeech: n
    example: "\uD3C9\uD589\uD55C \uB450 \uAC15\uC774 \uC6B0\uB9AC \uC591\uC606\uC73C\uB85C
      \uD758\uB800\uB2E4."
    exampleMeaning: Two parallel rivers ran on either side of us.
    story: 122
    storyHeading: 
    romanization: yangnyeop
  - id: ko_ttaemun
    english: "\uB54C\uBB38"
    meaning: because of
    partOfSpeech: n
    example: "\uC7A6\uC740 \uBE44 \uB54C\uBB38\uC5D0 \uB0B4 \uAE30\uB85D\uC740 \uC5C9\uB9DD\uC774
      \uB418\uC5C8\uB2E4."
    exampleMeaning: Frequent rain turned my notes into mush.
    story: 123
    storyHeading: 
    romanization: ttaemun
  - id: ko_dwijjok
    english: "\uB4A4\uCABD"
    meaning: back, rear
    partOfSpeech: n
    example: "\uBC30 \uB4A4\uCABD\uC5D0\uC11C \uBB54\uAC00 \uC6C0\uC9C1\uC600\uB2E4."
    exampleMeaning: Something moved at the rear of the boat.
    story: 124
    storyHeading: 
    romanization: dwijjok
  - id: ko_mullon
    english: "\uBB3C\uB860"
    meaning: of course
    partOfSpeech: adv
    example: "\uADF8\uAC83\uC758 \uB3C5\uD2B9\uD55C \uC7AC\uC8FC\uB294 \uB0B4\uAC00
      \uD558\uB294 \uB9D0\uC744 \uC804\uBD80 \uB530\uB77C \uD558\uB294 \uAC83\uC774\uC5C8\uB2E4.
      \uBB3C\uB860 \uC5C9\uD130\uB9AC\uB85C."
    exampleMeaning: Its unique talent was repeating everything I said, but badly.
    story: 125
    storyHeading: 
    romanization: mullon
  - id: ko_moksori
    english: "\uBAA9\uC18C\uB9AC"
    meaning: voice
    partOfSpeech: n
    example: "\uADF8\uAC83\uC740 \uB450 \uAC00\uC9C0 \uBAA9\uC18C\uB9AC\uB97C \uB0C8\uB2E4.
      \uD558\uB098\uB294 \uB0B4 \uBAA9\uC18C\uB9AC\uC600\uACE0, \uB2E4\uB978 \uD558\uB098\uB294
      \uADF8\uBCF4\uB2E4 \uB354 \uB054\uCC0D\uD588\uB2E4."
    exampleMeaning: 'It had a dual voice: one sounded like mine, and the other sounded
      even worse.'
    story: 126
    storyHeading: 
    romanization: moksori
  - id: ko_deutda
    english: "\uB4E3\uB2E4"
    meaning: to hear, to listen
    partOfSpeech: v
    example: "\uB098\uB294 \uB610\uB837\uD55C \uB2E8\uC5B4 \uD558\uB098\uB97C \uB4E4\uC5C8\uB2E4.
      \"\uC9D1.\""
    exampleMeaning: 'I heard one distinct word: "Home."'
    story: 127
    storyHeading: 
    romanization: deutda
  - id: ko_naemsae
    english: "\uB0C4\uC0C8"
    meaning: smell
    partOfSpeech: n
    example: "\uC774\uACF3\uC5D0\uC11C\uB294 \uC2DC\uAC01 \uD45C\uC9C0\uD310\uC774
      \uC18C\uC6A9\uC5C6\uC5B4\uC11C \uB300\uC2E0 \uB0C4\uC0C8\uB97C \uB530\uB77C\uAC04\uB2E4."
    exampleMeaning: Visual signs are useless here, so I follow my nose instead.
    story: 128
    storyHeading: 
    romanization: naemsae
  - id: ko_sudan
    english: "\uC218\uB2E8"
    meaning: means
    partOfSpeech: n
    example: "\uC774 \uBE44\uC5D0 \uC885\uC774\uB294 \uD615\uD3B8\uC5C6\uB294 \uC218\uB2E8\uC774\uB2E4."
    exampleMeaning: Paper is a poor medium in this rain.
    story: 129
    storyHeading: 
    romanization: sudan
  - id: ko_ije
    english: "\uC774\uC81C"
    meaning: now
    partOfSpeech: adv
    example: "\uD300\uC740 \uC774\uC81C \uC0DD\uC874 \uBAA8\uB4DC\uB2E4."
    exampleMeaning: The crew is in survival mode now.
    story: 130
    storyHeading: 
    romanization: ije
  - id: ko_naembi
    english: "\uB0C4\uBE44"
    meaning: pot
    partOfSpeech: n
    example: "\uC6B0\uB9AC\uC758 \uC774\uB3D9\uC2DD \uC8FC\uBC29\uC740 \uB178\uC0C8\uC5D0
      \uBB36\uC5B4 \uB454 \uB0C4\uBE44 \uD558\uB098\uAC00 \uC804\uBD80\uB2E4."
    exampleMeaning: Our mobile kitchen consists of a pot strapped to the mule.
    story: 131
    storyHeading: 
    romanization: naembi
  - id: ko_siseol
    english: "\uC2DC\uC124"
    meaning: facility
    partOfSpeech: n
    example: "\uC5EC\uAE30 \uC720\uC77C\uD55C \uC2DC\uC124\uC740 \uC544\uC8FC \uC740\uBC00\uD55C
      \uB364\uBD88\uC774\uB2E4."
    exampleMeaning: The only facility here is a very private bush.
    story: 132
    storyHeading: 
    romanization: siseol
  - id: ko_juin
    english: "\uC8FC\uC778"
    meaning: owner, master
    partOfSpeech: n
    example: "\uC6B0\uB9AC \uC8FC\uC778\uC740 \uC544\uC8FC \uB299\uC740 \uAC70\uBD81\uC774\uC5C8\uB2E4."
    exampleMeaning: Our host was a very old turtle.
    story: 133
    storyHeading: 
    romanization: juin
  - id: ko_bucheo
    english: "\uBD80\uCC98"
    meaning: ministry
    partOfSpeech: n
    example: "\uBD80\uCC98\uB294 \uC11C\uB958\uC5D0 \uC774\uACF3\uC744 \uD734\uC591\uC9C0\uB77C\uACE0
      \uC801\uC5C8\uB2E4."
    exampleMeaning: The ministry called this place a resort on the form.
    story: 134
    storyHeading: 
    romanization: bucheo
  - id: ko_hanttae
    english: "\uD55C\uB54C"
    meaning: once, at one time
    partOfSpeech: n
    example: "\uD55C\uB54C \uC5EC\uD589\uC774 \uB0AD\uB9CC\uC801\uC774\uB77C \uC0DD\uAC01\uD588\uB2E4."
    exampleMeaning: I once thought travel was romantic.
    story: 135
    storyHeading: 
    romanization: hanttae
  - id: ko_an
    english: "\uC548"
    meaning: not
    partOfSpeech: adv
    example: "\uC9C0\uB3C4\uB97C \uD5A5\uD55C \uC5F4\uC815\uC740 \uB9D0\uB790\uC9C0\uB9CC
      \uC591\uB9D0\uC740 \uC548 \uB9D0\uB790\uB2E4."
    exampleMeaning: My passion for maps has dried up; my socks have not.
    story: 136
    storyHeading: 
    romanization: an
  - id: ko_jeonhyeo
    english: "\uC804\uD600"
    meaning: not at all
    partOfSpeech: adv
    example: "\uC5EC\uAE30\uB294 \uC7A0\uC790\uAE30\uC5D0 \uC804\uD600 \uC774\uC0C1\uC801\uC778
      \uC7A5\uC18C\uAC00 \uC544\uB2C8\uB2E4."
    exampleMeaning: This is hardly an ideal place to sleep.
    story: 137
    storyHeading: 
    romanization: jeonhyeo
  - id: ko_ulda
    english: "\uC6B8\uB2E4"
    meaning: to cry
    partOfSpeech: v
    example: "\uC81C\uB300\uB85C \uB41C \uB2F4\uC694 \uD558\uB098\uB9CC \uC788\uC5B4\uB3C4
      \uAC10\uACA9\uD574\uC11C \uC6B8 \uAC83 \uAC19\uB2E4."
    exampleMeaning: A decent blanket would be enough to make me cry.
    story: 138
    storyHeading: 
    romanization: ulda
  - id: ko_jeokdanghada
    english: "\uC801\uB2F9\uD558\uB2E4"
    meaning: suitable, moderate
    partOfSpeech: adj
    example: "\uC774\uACF3\uC5D0\uC11C\uB294 \uC801\uB2F9\uD55C \uBE44\uB9CC \uB0B4\uB824\uB3C4
      \uC791\uC740 \uD64D\uC218\uAC00 \uB09C\uB2E4."
    exampleMeaning: Moderate rain here is enough to cause a small flood.
    story: 139
    storyHeading: 
    romanization: jeokdanghada
  - id: ko_gaeguri
    english: "\uAC1C\uAD6C\uB9AC"
    meaning: frog
    partOfSpeech: n
    example: "\uC694\uB9AC\uC0AC\uB294 \uB0B4\uAC00 \uC774\uC81C \uB354 \uC131\uC219\uD574\uC84C\uB2E4\uACE0
      \uD55C\uB2E4. \uBC29\uAE08 \uAC1C\uAD6C\uB9AC\uB97C \uBB3C\uC5B4\uB72F\uC5C8\uC744
      \uBFD0\uC778\uB370."
    exampleMeaning: The cook says I am more mature now. I just bit a frog.
    story: 140
    storyHeading: 
    romanization: gaeguri
  - id: ko_dallida
    english: "\uB2EC\uB9AC\uB2E4"
    meaning: to run
    partOfSpeech: v
    example: "\uC6B0\uB9AC \uD300\uC740 \uC5ED\uB3D9\uC801\uC774\uB2E4. \uC0AC\uBC29\uC73C\uB85C
      \uB2EC\uB9B0\uB2E4."
    exampleMeaning: 'Our team is dynamic: we run in all directions.'
    story: 141
    storyHeading: 
    romanization: dallida
  - id: ko_bangbeop
    english: "\uBC29\uBC95"
    meaning: method
    partOfSpeech: n
    example: "\uAC15\uC744 \uAC74\uB108\uB294 \uAC00\uC7A5 \uD6A8\uC728\uC801\uC778
      \uBC29\uBC95\uC740 \uADF8\uB0E5 \uBE60\uC9C0\uB294 \uAC83\uC774\uB2E4."
    exampleMeaning: The most efficient way to cross the river is to fall into it.
    story: 142
    storyHeading: 
    romanization: bangbeop
  - id: ko_hubo
    english: "\uD6C4\uBCF4"
    meaning: candidate
    partOfSpeech: n
    example: "\uC774 \uBC14\uC704\uC758 \uC2DC\uC7A5 \uD6C4\uBCF4\uB294 \uB098\uBFD0\uC774\uB2E4."
    exampleMeaning: I am the only candidate for mayor of this rock.
    story: 143
    storyHeading: "55\uC77C\uC9F8"
    romanization: hubo
  - id: ko_bawi
    english: "\uBC14\uC704"
    meaning: rock
    partOfSpeech: n
    example: "\uB2F9\uC120\uB410\uB2E4. \uC774\uC81C \uB098\uB294 \uC816\uC740 \uBC14\uC704\uC758
      \uC2DC\uC7A5\uC774\uB2E4."
    exampleMeaning: I won. I am now the mayor of a wet rock.
    story: 144
    storyHeading: 
    romanization: bawi
  - id: ko_oda
    english: "\uC624\uB2E4"
    meaning: to come
    partOfSpeech: v
    example: "\uB0B4 \uC9D1\uD68C\uC5D0\uB294 \uB178\uC0C8 \uB9D0\uACE0 \uC544\uBB34\uB3C4
      \uC624\uC9C0 \uC54A\uC558\uB2E4."
    exampleMeaning: Nobody came to my rally except the mule.
    story: 145
    storyHeading: 
    romanization: oda
  - id: ko_cheot
    english: "\uCCAB"
    meaning: first
    partOfSpeech: adj
    example: "\uB098\uC758 \uCCAB \uBC88\uC9F8 \uAC1C\uD601\uC740 \uBAA8\uB450\uC5D0\uAC8C
      \uC218\uD504\uB97C \uB354 \uC8FC\uB294 \uAC83\uC774\uB2E4."
    exampleMeaning: 'My first reform: more soup for everyone.'
    story: 146
    storyHeading: 
    romanization: cheot
  - id: ko_ppaeatda
    english: "\uBE7C\uC557\uB2E4"
    meaning: to take away, to rob
    partOfSpeech: v
    example: "\uB178\uC0C8\uAC00 \uD601\uBA85\uC744 \uC77C\uC73C\uCF1C \uC218\uD504\uB97C
      \uBE7C\uC557\uC544 \uAC14\uB2E4."
    exampleMeaning: The mule started a revolution and seized the soup.
    story: 147
    storyHeading: 
    romanization: ppaeatda
  - id: ko_deulda
    english: "\uB4E4\uB2E4"
    meaning: to carry, to lift
    partOfSpeech: v
    example: "\uC6B0\uB9AC\uB294 \uC870\uC57D\uC744 \uB9FA\uC5C8\uB2E4. \uAC00\uBC29\uC740
      \uB0B4\uAC00 \uB4E4\uACE0, \uB178\uC0C8\uB294 \uC544\uBB34\uAC83\uB3C4 \uB4E4\uC9C0
      \uC54A\uB294\uB2E4."
    exampleMeaning: 'We signed a treaty: I carry the bags, and the mule carries nothing.'
    story: 148
    storyHeading: 
    romanization: deulda
  - id: ko_mulda
    english: "\uBB3C\uB2E4"
    meaning: to bite
    partOfSpeech: v
    example: "\uB178\uC0C8\uB294 \uB098\uB97C \uBB3C\uC9C0 \uC54A\uB294 \uAC83\uC73C\uB85C
      \uB3D9\uC758\uD588\uB2E4."
    exampleMeaning: The mule gave its consent by not biting me.
    story: 149
    storyHeading: 
    romanization: mulda
  - id: ko_joyak
    english: "\uC870\uC57D"
    meaning: treaty
    partOfSpeech: n
    example: "\uADF8\uB7EC\uB354\uB2C8 \uB178\uC0C8\uB294 \uC81C\uBA4B\uB300\uB85C
      \uC870\uC57D\uC744 \uBA39\uC5B4 \uCE58\uC6E0\uB2E4."
    exampleMeaning: It then took the liberty of eating the treaty.
    story: 150
    storyHeading: 
    romanization: joyak
  - id: ko_gonghwaguk
    english: "\uACF5\uD654\uAD6D"
    meaning: republic
    partOfSpeech: n
    example: "\uC6B0\uB9AC\uB294 \uC774\uC81C \uC0AC\uB78C \uD558\uB098\uC640 \uB178\uC0C8
      \uD558\uB098\uC758 \uACF5\uD654\uAD6D\uC774\uB2E4."
    exampleMeaning: We are now a republic of one person and one mule.
    story: 151
    storyHeading: 
    romanization: gonghwaguk
  - id: ko_kkaeda
    english: "\uAE68\uB2E4"
    meaning: to wake up
    partOfSpeech: v
    example: "\uC6B0\uB9AC \uC758\uD68C\uB294 \uB178\uC0C8\uAC00 \uAE70 \uB54C\uB9C8\uB2E4
      \uC5F4\uB9B0\uB2E4."
    exampleMeaning: Our parliament meets whenever the mule wakes up.
    story: 152
    storyHeading: 
    romanization: kkaeda
  - id: ko_bandaehada
    english: "\uBC18\uB300\uD558\uB2E4"
    meaning: to oppose
    partOfSpeech: v
    example: "\uAC1C\uAD6C\uB9AC \uD68C\uC758\uAC00 \uB098\uB97C \uBC18\uB300\uD558\uAE30\uB85C
      \uD45C\uACB0\uD588\uB2E4."
    exampleMeaning: A congress of frogs voted against me.
    story: 153
    storyHeading: 
    romanization: bandaehada
  - id: ko_eoryeowojida
    english: "\uC5B4\uB824\uC6CC\uC9C0\uB2E4"
    meaning: to become difficult
    partOfSpeech: v
    example: "\uB178\uC0C8\uB9CC \uD22C\uD45C\uAD8C\uC744 \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74
      \uBBFC\uC8FC\uC8FC\uC758\uB294 \uC5B4\uB824\uC6CC\uC9C4\uB2E4."
    exampleMeaning: Democracy is difficult when the mule has the only vote.
    story: 154
    storyHeading: 
    romanization: eoryeowojida
  - id: ko_sanghwang
    english: "\uC0C1\uD669"
    meaning: situation
    partOfSpeech: n
    example: "\uC774\uB7F0 \uC0C1\uD669\uC5D0 \uC801\uC6A9\uB418\uB294 \uC5F0\uBC29\uBC95\uC740
      \uC5C6\uB294 \uAC83 \uAC19\uB2E4."
    exampleMeaning: No federal law seems to cover this situation.
    story: 155
    storyHeading: 
    romanization: sanghwang
  - id: ko_eommu
    english: "\uC5C5\uBB34"
    meaning: work, duties
    partOfSpeech: n
    example: "\uB178\uC0C8\uC758 \uBCF5\uC9C0\uAC00 \uC774\uC81C \uB0B4 \uC8FC \uC5C5\uBB34\uB2E4."
    exampleMeaning: The mule's welfare is now my main task.
    story: 156
    storyHeading: 
    romanization: eommu
  - id: ko_yeolmae
    english: "\uC5F4\uB9E4"
    meaning: fruit
    partOfSpeech: n
    example: "\uC815\uAE00\uC740 \uC790\uC120\uD558\uB4EF \uB0B4\uAC8C \uC5F4\uB9E4\uB97C
      \uC8FC\uC5C8\uB2E4."
    exampleMeaning: The jungle gave me fruit out of charity.
    story: 157
    storyHeading: 
    romanization: yeolmae
  - id: ko_hoesa
    english: "\uD68C\uC0AC"
    meaning: company
    partOfSpeech: n
    example: "\uB0B4 \uD68C\uC0AC \uC0DD\uD65C \uC608\uC808\uC740 \uB2AA \uC5B4\uB518\uAC00\uC5D0\uC11C
      \uC0AC\uB77C\uC838 \uBC84\uB838\uB2E4."
    exampleMeaning: My corporate manners disappeared somewhere in the swamp.
    story: 158
    storyHeading: 
    romanization: hoesa
  - id: ko_saeop
    english: "\uC0AC\uC5C5"
    meaning: business
    partOfSpeech: n
    example: "\uC774 \uC0AC\uC5C5 \uC804\uCCB4\uAC00 \uC2E4\uC218\uC600\uB2E4."
    exampleMeaning: This whole enterprise was a mistake.
    story: 159
    storyHeading: 
    romanization: saeop
  - id: ko_geuripda
    english: "\uADF8\uB9BD\uB2E4"
    meaning: to miss (someone)
    partOfSpeech: adj
    example: "\uB9C8\uB978 \uC591\uB9D0\uC744 \uD30C\uB294 \uC18C\uB9E4\uC810\uB4E4\uC774
      \uADF8\uB9BD\uB2E4."
    exampleMeaning: I miss retail shops and their dry socks.
    story: 160
    storyHeading: 
    romanization: geuripda
  - id: ko_namu
    english: "\uB098\uBB34"
    meaning: tree, wood
    partOfSpeech: n
    example: "\uC5EC\uAE30\uC11C \uC720\uC77C\uD55C \uD654\uD3D0\uB294 \uB9C8\uB978
      \uB098\uBB34\uB2E4."
    exampleMeaning: Here, the only currency is dry wood.
    story: 161
    storyHeading: 
    romanization: namu
  - id: ko_yangpa
    english: "\uC591\uD30C"
    meaning: onion
    partOfSpeech: n
    example: "\uC694\uB9AC\uC0AC\uB294 \uB9C8\uC9C0\uB9C9 \uC591\uD30C\uB97C \uACBD\uB9E4\uC5D0
      \uBD80\uCCE4\uB2E4."
    exampleMeaning: The cook held an auction for the last onion.
    story: 162
    storyHeading: 
    romanization: yangpa
  - id: ko_moja
    english: "\uBAA8\uC790"
    meaning: hat
    partOfSpeech: n
    example: "\uBAA8\uC790\uB97C \uC8FC\uACE0 \uC591\uD30C \uD558\uB098\uB97C \uC190\uC5D0
      \uB123\uC5C8\uB2E4."
    exampleMeaning: I managed to obtain one onion by trading my hat.
    story: 163
    storyHeading: 
    romanization: moja
  - id: ko_geumji
    english: "\uAE08\uC9C0"
    meaning: ban, prohibition
    partOfSpeech: n
    example: "\uBC24\uC5D0 \uB178\uB798\uD558\uB294 \uAC83\uC744 \uAE08\uC9C0\uD574\uC57C
      \uD588\uB2E4."
    exampleMeaning: We had to ban singing at night.
    story: 164
    storyHeading: 
    romanization: geumji
  - id: ko_wichi
    english: "\uC704\uCE58"
    meaning: location
    partOfSpeech: n
    example: "\uAC1C\uAD6C\uB9AC\uB4E4\uC740 \uB9E4\uC77C \uBC24 \uC6B0\uB9AC\uC758
      \uC704\uCE58\uB97C \uBC29\uC1A1\uD55C\uB2E4."
    exampleMeaning: The frogs broadcast our location every night.
    story: 165
    storyHeading: 
    romanization: wichi
  - id: ko_daepyo
    english: "\uB300\uD45C"
    meaning: representative
    partOfSpeech: n
    example: "\uC774\uC81C \uB098\uB294 \uC815\uBD80 \uBD80\uCC98\uB97C \uB300\uD45C\uD574
      \uAC1C\uAD6C\uB9AC\uB4E4\uC5D0\uAC8C \uD30C\uACAC\uB41C \uB300\uC0AC\uB2E4."
    exampleMeaning: I am now the ministry's ambassador to the frogs.
    story: 166
    storyHeading: 
    romanization: daepyo
  - id: ko_daesin
    english: "\uB300\uC2E0"
    meaning: instead
    partOfSpeech: n
    example: "\uBD80\uCC98\uB97C \uB300\uC2E0\uD574 \uC774 \uAC15\uC5D0 \uC0AC\uACFC\uD55C\uB2E4."
    exampleMeaning: On behalf of the ministry, I apologize to this river.
    story: 167
    storyHeading: 
    romanization: daesin
  - id: ko_moyang
    english: "\uBAA8\uC591"
    meaning: shape
    partOfSpeech: n
    example: "\uB178\uC0C8\uB294 \uC790\uAE30\uAC00 \uD669\uC18C\uB77C\uACE0 \uC0DD\uAC01\uD558\uB294
      \uBAA8\uC591\uC774\uB2E4."
    exampleMeaning: The mule seems to think it is a bull.
    story: 168
    storyHeading: 
    romanization: moyang
  - id: ko_yumyeong
    english: "\uC720\uBA85"
    meaning: fame
    partOfSpeech: n
    example: "\uC774 \uC815\uAE00\uC5D0\uC11C \uB178\uC0C8\uB294 \uC720\uBA85 \uC778\uC0AC\uB2E4."
    exampleMeaning: In this jungle, the mule is a celebrity.
    story: 169
    storyHeading: 
    romanization: yumyeong
  - id: ko_gidaehada
    english: "\uAE30\uB300\uD558\uB2E4"
    meaning: to expect
    partOfSpeech: v
    example: "\uB204\uAD70\uAC00\uB294 \uB178\uC0C8\uB97C \uCE6D\uCC2C\uD574\uC57C
      \uD55C\uB2E4. \uB0B4\uAC00 \uD560 \uAC70\uB77C\uACE0 \uAE30\uB300\uD558\uC9C0\uB294
      \uB9D0\uACE0."
    exampleMeaning: Someone should praise the mule. Just don't expect it to be me.
    story: 170
    storyHeading: 
    romanization: gidaehada
  - id: ko_gongbu
    english: "\uACF5\uBD80"
    meaning: study
    partOfSpeech: n
    example: "\uB178\uC0C8 \uC2EC\uB9AC\uD559\uC744 \uACF5\uBD80\uD588\uB2E4. \uB300\uBD80\uBD84
      \uC559\uC2EC\uC73C\uB85C \uC774\uB8E8\uC5B4\uC9C4 \uAC83 \uAC19\uB2E4."
    exampleMeaning: I studied mule psychology. It seems to consist mostly of spite.
    story: 171
    storyHeading: 
    romanization: gongbu
  - id: ko_oreuda
    english: "\uC624\uB974\uB2E4"
    meaning: to climb, to rise
    partOfSpeech: v
    example: "\uBB3C\uB9AC\uD559\uC801\uC73C\uB85C \uB178\uC0C8\uB294 \uC800\uACF3\uC5D0
      \uC624\uB97C \uC218 \uC5C6\uB2E4. \uD558\uC9C0\uB9CC \uC774 \uB140\uC11D\uC740
      \uC62C\uB77C\uAC14\uB2E4."
    exampleMeaning: Physics says mules cannot climb that. But this one did.
    story: 172
    storyHeading: 
    romanization: oreuda
  - id: ko_kkokdaegi
    english: "\uAF2D\uB300\uAE30"
    meaning: top, peak
    partOfSpeech: n
    example: "\uB098\uBB34 \uAF2D\uB300\uAE30\uC5D0\uC11C \uB3CC\uC9C0\uBD95\uB4E4\uC774
      \uBCF4\uC600\uB2E4."
    exampleMeaning: From the peak of a tree, I saw stone roofs.
    story: 173
    storyHeading: "70\uC77C\uC9F8"
    romanization: kkokdaegi
  - id: ko_sok
    english: "\uC18D"
    meaning: inside
    partOfSpeech: n
    example: "\uACE0\uB300 \uC720\uC801\uC774 \uCD08\uB85D \uC18D\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
    exampleMeaning: Ancient ruins stood in the green.
    story: 174
    storyHeading: 
    romanization: sok
  - id: ko_sawon
    english: "\uC0AC\uC6D0"
    meaning: temple
    partOfSpeech: n
    example: "\uC0AC\uC6D0\uC5D0\uB294 \uBB38\uB3C4 \uC774\uB984\uB3C4 \uC5C6\uC5C8\uB2E4."
    exampleMeaning: The temple had no door and no name.
    story: 175
    storyHeading: 
    romanization: sawon
  - id: ko_beotda
    english: "\uBC97\uB2E4"
    meaning: to take off
    partOfSpeech: v
    example: "\uC2E0\uC131\uD55C \uACF3 \uAC19\uC544\uC11C \uC9C4\uD759 \uBB3B\uC740
      \uBAA8\uC790\uB97C \uBC97\uC5C8\uB2E4."
    exampleMeaning: The place felt holy, so I took off my muddy hat.
    story: 176
    storyHeading: 
    romanization: beotda
  - id: ko_bida
    english: "\uBE44\uB2E4"
    meaning: to be empty
    partOfSpeech: v
    example: "\uB3CC\uB85C \uB41C \uC0AC\uC81C\uAC00 \uBE48 \uC11D\uD310\uC744 \uB4E4\uACE0
      \uC788\uC5C8\uB2E4."
    exampleMeaning: A stone priest held a blank tablet.
    story: 177
    storyHeading: 
    romanization: bida
  - id: ko_oraejeon
    english: "\uC624\uB798\uC804"
    meaning: long ago
    partOfSpeech: n
    example: "\uC624\uB798\uC804 \uC0AC\uB78C\uB4E4\uC774 \uC608\uBC30\uD558\uB7EC
      \uC5EC\uAE30 \uC654\uB2E4."
    exampleMeaning: People came here for worship long ago.
    story: 178
    storyHeading: 
    romanization: oraejeon
  - id: ko_jonggyo
    english: "\uC885\uAD50"
    meaning: religion
    partOfSpeech: n
    example: "\uC774 \uC885\uAD50\uB294 \uBAA8\uB974\uC9C0\uB9CC, \uADF8 \uB450\uB824\uC6C0\uC740
      \uC548\uB2E4."
    exampleMeaning: I do not know this religion, but I know its fear.
    story: 179
    storyHeading: 
    romanization: jonggyo
  - id: ko_gaunde
    english: "\uAC00\uC6B4\uB370"
    meaning: middle
    partOfSpeech: n
    example: "\uBCBD\uC758 \uC0C1\uC9D5\uB9C8\uB2E4 \uAC00\uC6B4\uB370\uC5D0 \uAD6C\uBA4D\uC774
      \uB098 \uC788\uC5C8\uB2E4."
    exampleMeaning: Every symbol on the wall had a hole in the middle.
    story: 180
    storyHeading: 
    romanization: gaunde
  - id: ko_ppajida
    english: "\uBE60\uC9C0\uB2E4"
    meaning: to fall out, to be missing
    partOfSpeech: v
    example: "\uAE30\uB465\uB9C8\uB2E4 \uB2E8\uC5B4\uAC00 \uBE60\uC9C4 \uBB38\uC7A5\uC774
      \uC0C8\uACA8\uC838 \uC788\uC5C8\uB2E4."
    exampleMeaning: Each column held a sentence with a missing word.
    story: 181
    storyHeading: 
    romanization: ppajida
  - id: ko_anida
    english: "\uC544\uB2C8\uB2E4"
    meaning: to not be
    partOfSpeech: adj
    example: "\uC774 \uC720\uC0B0\uC740 \uC774\uC81C \uB204\uAD6C\uC758 \uAC83\uB3C4
      \uC544\uB2C8\uB2E4."
    exampleMeaning: This heritage belongs to nobody now.
    story: 182
    storyHeading: 
    romanization: anida
  - id: ko_sidae
    english: "\uC2DC\uB300"
    meaning: era, age
    partOfSpeech: n
    example: "\uADF8 \uB9D0\uB4E4\uC740 \uB2E4\uB978 \uC2DC\uB300\uC5D0\uC11C \uC654\uB2E4."
    exampleMeaning: Those words came from another era.
    story: 183
    storyHeading: 
    romanization: sidae
  - id: ko_susip
    english: "\uC218\uC2ED"
    meaning: dozens of
    partOfSpeech: adj
    example: "\uC218\uC2ED \uB144 \uB3D9\uC548 \uB204\uAD70\uAC00 \uB3CC\uC744 \uAE68\uB057\uC774
      \uB2E6\uC544 \uC654\uB2E4."
    exampleMeaning: Decade after decade, someone kept the stones clean.
    story: 184
    storyHeading: 
    romanization: susip
  - id: ko_eumsik
    english: "\uC74C\uC2DD"
    meaning: food
    partOfSpeech: n
    example: "\uC774\uACF3 \uD48D\uC2B5\uC740 \uBB38 \uC55E\uC5D0 \uC74C\uC2DD\uC744
      \uB450\uB294 \uAC83\uC778 \uB4EF\uD558\uB2E4."
    exampleMeaning: The local custom seems to be leaving food at the door.
    story: 185
    storyHeading: 
    romanization: eumsik
  - id: ko_nongeop
    english: "\uB18D\uC5C5"
    meaning: agriculture
    partOfSpeech: n
    example: "\uC5EC\uAE30 \uC0AC\uB78C\uB4E4\uC740 \uD55C\uB54C \uB18D\uC5C5\uC73C\uB85C
      \uC0B4\uC558\uB2E4."
    exampleMeaning: The people here once lived by agriculture.
    story: 186
    storyHeading: 
    romanization: nongeop
  - id: ko_gisul
    english: "\uAE30\uC220"
    meaning: skill, technique
    partOfSpeech: n
    example: "\uC774 \uC0AC\uB78C\uB4E4\uC758 \uAE30\uC220\uC740 \uBAA8\uB4E0 \uB3CC\uC5D0
      \uB0A8\uC544 \uC788\uB2E4."
    exampleMeaning: The craft of these people still stands in every stone.
    story: 187
    storyHeading: 
    romanization: gisul
  - id: ko_jjikda
    english: "\uCC0D\uB2E4"
    meaning: to stamp, to take (a photo)
    partOfSpeech: v
    example: "\uC548\uCABD\uC5D0 \uAE00\uC790\uAC00 \uCC0D\uD78C \uC810\uD1A0 \uD56D\uC544\uB9AC\uB97C
      \uCC3E\uC558\uB2E4."
    exampleMeaning: I found a clay pot with letters pressed inside.
    story: 188
    storyHeading: 
    romanization: jjikda
  - id: ko_bang
    english: "\uBC29"
    meaning: room
    partOfSpeech: n
    example: "\uD55C \uBC29\uC740 \uBE48 \uB3CC \uC5BC\uAD74\uB4E4\uC758 \uD654\uB791\uC774\uC5C8\uB2E4."
    exampleMeaning: One room was a gallery of blank stone faces.
    story: 189
    storyHeading: 
    romanization: bang
  - id: ko_seonsaengnim
    english: "\uC120\uC0DD\uB2D8"
    meaning: teacher
    partOfSpeech: n
    example: "\uADF8\uC911 \uD558\uB098\uB294 \uC606\uBAA8\uC2B5\uC774 \uAF2D \uC61B
      \uC120\uC0DD\uB2D8 \uAC19\uC558\uB2E4."
    exampleMeaning: In profile, one looked just like my old teacher.
    story: 190
    storyHeading: 
    romanization: seonsaengnim
  - id: ko_silta
    english: "\uC2EB\uB2E4"
    meaning: to dislike, unpleasant
    partOfSpeech: adj
    example: "\uC61B \uAD50\uC7A5 \uC120\uC0DD\uB2D8\uC774\uB77C\uBA74 \uC774 \uC5EC\uD589\uC744
      \uC2EB\uC5B4\uD588\uC744 \uAC83\uC774\uB2E4."
    exampleMeaning: My old principal would have hated this trip.
    story: 191
    storyHeading: 
    romanization: silta
  - id: ko_jeonseol
    english: "\uC804\uC124"
    meaning: legend
    partOfSpeech: n
    example: "\uC804\uC124\uC5D0 \uB530\uB974\uBA74 \uCCAB \uB9D0\uC774 \uC5EC\uAE30\uC11C
      \uB098\uC654\uB2E4."
    exampleMeaning: A legend says the first word was spoken here.
    story: 192
    storyHeading: 
    romanization: jeonseol
  - id: ko_jeokda
    english: "\uC801\uB2E4"
    meaning: to write down
    partOfSpeech: v
    example: "\uD5C8\uAD6C\uC77C\uC9C0 \uBAB0\uB77C\uB3C4 \uC801\uC5B4 \uB450\uC5C8\uB2E4."
    exampleMeaning: It may be fiction, but I wrote it down.
    story: 193
    storyHeading: 
    romanization: jeokda
  - id: ko_soseol
    english: "\uC18C\uC124"
    meaning: novel
    partOfSpeech: n
    example: "\uC694\uB9AC\uC0AC\uB294 \uC774\uAC8C \uD615\uD3B8\uC5C6\uB294 \uC18C\uC124\uC774
      \uB420 \uAC70\uB77C \uD55C\uB2E4."
    exampleMeaning: The cook says this would make a bad novel.
    story: 194
    storyHeading: 
    romanization: soseol
  - id: ko_jeoja
    english: "\uC800\uC790"
    meaning: author
    partOfSpeech: n
    example: "\uB098\uB294 \uC5ED\uC0AC\uC0C1 \uCD5C\uC545\uC758 \uC9C0\uB3C4\uC758
      \uC800\uC790\uB2E4."
    exampleMeaning: I am the author of the worst map ever made.
    story: 195
    storyHeading: 
    romanization: jeoja
  - id: ko_baegopeuda
    english: "\uBC30\uACE0\uD504\uB2E4"
    meaning: hungry
    partOfSpeech: adj
    example: "\uBC30\uACE0\uD514\uC740 \uBB38\uD559 \uD65C\uB3D9\uC5D0 \uC815\uB9D0
      \uC88B\uC9C0 \uC54A\uB2E4."
    exampleMeaning: Hunger is terrible for literature.
    story: 196
    storyHeading: 
    romanization: baegopeuda
  - id: ko_juje
    english: "\uC8FC\uC81C"
    meaning: subject, theme
    partOfSpeech: n
    example: "\uC774 \uC77C\uC9C0\uC758 \uC8FC\uC81C\uB294 \uC9C4\uD759\uC774\uB2E4."
    exampleMeaning: The theme of this journal is mud.
    story: 197
    storyHeading: 
    romanization: juje
  - id: ko_mareuda
    english: "\uB9C8\uB974\uB2E4"
    meaning: to dry
    partOfSpeech: v
    example: "\uC774\uC81C \uB0B4 \uCCA0\uD559\uC740 \uAC04\uB2E8\uD558\uB2E4. \uC591\uB9D0\uC744
      \uB9C8\uB974\uAC8C \uC720\uC9C0\uD560 \uAC83."
    exampleMeaning: 'My philosophy now is simple: keep your socks dry.'
    story: 198
    storyHeading: 
    romanization: mareuda
  - id: ko_jalmot
    english: "\uC798\uBABB"
    meaning: wrongdoing, fault
    partOfSpeech: n
    example: "\uB178\uC0C8\uC758 \uAD00\uC810\uC5D0\uC11C \uBCF4\uBA74 \uBAA8\uB4E0
      \uAC8C \uB0B4 \uC798\uBABB\uC774\uB2E4."
    exampleMeaning: From a mule's perspective, everything is my fault.
    story: 199
    storyHeading: 
    romanization: jalmot
  - id: ko_tat
    english: "\uD0D3"
    meaning: blame
    partOfSpeech: n
    example: "\uADF8\uC640 \uB300\uC870\uC801\uC73C\uB85C \uC694\uB9AC\uC0AC\uB294
      \uB108\uAD6C\uB9AC \uD0D3\uC744 \uD55C\uB2E4."
    exampleMeaning: In contrast, the cook blames the raccoon.
    story: 200
    storyHeading: 
    romanization: tat
  - id: ko_choeak
    english: "\uCD5C\uC545"
    meaning: the worst
    partOfSpeech: n
    example: "\uC815\uAE00\uC758 \uCD5C\uC545\uC758 \uCE21\uBA74\uC740 \uB178\uB798\uD558\uB294
      \uAC1C\uAD6C\uB9AC\uB4E4\uC774\uB2E4."
    exampleMeaning: The worst aspect of the jungle is the singing frogs.
    story: 201
    storyHeading: 
    romanization: choeak
  - id: ko_malhada
    english: "\uB9D0\uD558\uB2E4"
    meaning: to speak, to say
    partOfSpeech: v
    example: "\uACBD\uACC4\uB97C \uB2A6\uCD94\uC9C0 \uB9D0 \uAC83. \uB450\uAEBC\uBE44\uB294
      \uB124\uAC00 \uB9D0\uD558\uB294 \uAC83\uC740 \uBB34\uC5C7\uC774\uB4E0 \uC0BC\uD0A8\uB2E4."
    exampleMeaning: 'Stay alert: the toad swallows anything you say.'
    story: 202
    storyHeading: "85\uC77C\uC9F8"
    romanization: malhada
  - id: ko_geodaehada
    english: "\uAC70\uB300\uD558\uB2E4"
    meaning: huge
    partOfSpeech: adj
    example: "\uAC70\uB300\uD55C \uB450\uAEBC\uBE44\uAC00 \uC694\uB9AC\uC0AC\uC758
      \uB9C8\uC9C0\uB9C9 \uB9D0\uC744 \uC0AC\uB85C\uC7A1\uC73C\uB824 \uD588\uB2E4."
    exampleMeaning: A giant toad tried to capture the cook's last word.
    story: 203
    storyHeading: 
    romanization: geodaehada
  - id: ko_daedanhada
    english: "\uB300\uB2E8\uD558\uB2E4"
    meaning: great, amazing
    partOfSpeech: adj
    example: "\uADF8 \uD600\uB294 \uB180\uB77C\uC6B8 \uC815\uB3C4\uB85C \uB300\uB2E8\uD558\uACE0,
      \uC2DD\uC695\uB3C4 \uADF8\uC5D0 \uBABB\uC9C0\uC54A\uB2E4."
    exampleMeaning: Its tongue is extraordinary, and its appetite is just as impressive.
    story: 204
    storyHeading: 
    romanization: daedanhada
  - id: ko_yonggi
    english: "\uC6A9\uAE30"
    meaning: courage
    partOfSpeech: n
    example: "\uB178\uC0C8\uB294 \uB3C4\uB9DD\uCE58\uB294 \uAC83\uC73C\uB85C \uB6F0\uC5B4\uB09C
      \uC6A9\uAE30\uB97C \uBCF4\uC600\uB2E4."
    exampleMeaning: The mule showed outstanding courage by running away.
    story: 205
    storyHeading: 
    romanization: yonggi
  - id: ko_choego
    english: "\uCD5C\uACE0"
    meaning: the best
    partOfSpeech: n
    example: "\uB3C4\uB9DD\uCE58\uB294 \uAC83\uC774 \uB0B4 \uCD5C\uACE0\uC758 \uC7AC\uB2A5\uC774\uB2E4."
    exampleMeaning: Running away is my greatest talent.
    story: 206
    storyHeading: 
    romanization: choego
  - id: ko_jal
    english: "\uC798"
    meaning: well
    partOfSpeech: adv
    example: "\uB098\uB294 \uCC9C\uC7AC\uB294 \uC544\uB2C8\uC9C0\uB9CC, \uB450\uB824\uC6B0\uBA74
      \uB098\uBB34\uB97C \uC798 \uD0C4\uB2E4."
    exampleMeaning: I am no genius, but fear makes me a good climber.
    story: 207
    storyHeading: 
    romanization: jal
  - id: ko_ttokttokada
    english: "\uB611\uB611\uD558\uB2E4"
    meaning: smart
    partOfSpeech: adj
    example: "\uADF8 \uB450\uAEBC\uBE44\uB294 \uB0B4 \uC61B \uC0C1\uC0AC\uBCF4\uB2E4
      \uB611\uB611\uD558\uB2E4."
    exampleMeaning: The toad is more intelligent than my old boss.
    story: 208
    storyHeading: 
    romanization: ttokttokada
  - id: ko_yeojeonhi
    english: "\uC5EC\uC804\uD788"
    meaning: still
    partOfSpeech: adv
    example: "\uC0C1\uAE09 \uAD00\uB9AC\uC870\uCC28 \uC5EC\uC804\uD788 \uB0B4\uAC8C
      \uC11C\uB958\uB97C \uC791\uC131\uD558\uB77C\uACE0 \uD560 \uAC83\uC774\uB2E4."
    exampleMeaning: Even a superior officer would still ask me to fill out a form.
    story: 209
    storyHeading: 
    romanization: yeojeonhi
  - id: ko_amu
    english: "\uC544\uBB34"
    meaning: any
    partOfSpeech: adj
    example: "\uC774 \uC815\uAE00\uC5D0\uC11C \uB0B4 \uACC4\uAE09\uC740 \uC544\uBB34
      \uC758\uBBF8\uB3C4 \uC5C6\uB2E4."
    exampleMeaning: In this jungle, my rank means nothing.
    story: 210
    storyHeading: 
    romanization: amu
  - id: ko_yakgan
    english: "\uC57D\uAC04"
    meaning: a little, slightly
    partOfSpeech: adv
    example: "\uB0B4 \uC0C1\uD0DC: \uC0DD\uC874 \uC911, \uAE38 \uC783\uC74C, \uC57D\uAC04
      \uBCF4\uB77C\uC0C9."
    exampleMeaning: 'My status: alive, lost, and slightly purple.'
    story: 211
    storyHeading: 
    romanization: yakgan
  - id: ko_teullimeopda
    english: "\uD2C0\uB9BC\uC5C6\uB2E4"
    meaning: certain, without doubt
    partOfSpeech: adj
    example: "\uBD80\uCC98\uC5D0\uC11C \uB0B4 \uD3C9\uD310\uC740 \uD2C0\uB9BC\uC5C6\uC774
      \uB05D\uC7A5\uB0AC\uB2E4."
    exampleMeaning: My reputation at the ministry is surely ruined.
    story: 212
    storyHeading: 
    romanization: teullimeopda
  - id: ko_wonhada
    english: "\uC6D0\uD558\uB2E4"
    meaning: to want
    partOfSpeech: v
    example: "\uBA85\uC131\uC744 \uC6D0\uD588\uC9C0\uB9CC, \uC774\uC81C\uB294 \uC218\uD504\uB97C
      \uC6D0\uD55C\uB2E4."
    exampleMeaning: I wanted fame; now I want soup.
    story: 213
    storyHeading: 
    romanization: wonhada
  - id: ko_jeongbu
    english: "\uC815\uBD80"
    meaning: government
    partOfSpeech: n
    example: "\uC815\uBD80 \uBD80\uCC98\uC758 \uC5D8\uB9AC\uD2B8\uB4E4\uC740 \uB2AA\uC744
      \uBCF8 \uC801\uC870\uCC28 \uC5C6\uB2E4."
    exampleMeaning: The elite at the ministry have never even seen a swamp.
    story: 214
    storyHeading: 
    romanization: jeongbu
  - id: ko_nun
    english: "\uB208"
    meaning: eye
    partOfSpeech: n
    example: "\uAC15 \uD55C\uAC00\uC6B4\uB370 \uB208\uC5D0 \uB744\uB294 \uBC14\uC704\uAC00
      \uC11C \uC788\uC5C8\uB2E4."
    exampleMeaning: A prominent rock stood in the middle of the river.
    story: 215
    storyHeading: 
    romanization: nun
  - id: ko_ontong
    english: "\uC628\uD1B5"
    meaning: entirely, all over
    partOfSpeech: adv
    example: "\uBC14\uC704 \uC815\uC0C1\uC5D0 \uC62C\uB77C\uAC14\uC9C0\uB9CC \uBCF4\uC774\uB294
      \uAC83\uC740 \uC628\uD1B5 \uBC14\uC704\uBFD0\uC774\uC5C8\uB2E4."
    exampleMeaning: From the summit of the rock, all I could see was more rock.
    story: 216
    storyHeading: 
    romanization: ontong
  - id: ko_gyosu
    english: "\uAD50\uC218"
    meaning: professor
    partOfSpeech: n
    example: "\uD55C \uAD50\uC218\uB294 \uC815\uAE00\uC774 \uC2E0\uD654\uB77C\uACE0
      \uB9D0\uD588\uC5C8\uB2E4."
    exampleMeaning: A professor once told me the jungle was a myth.
    story: 217
    storyHeading: 
    romanization: gyosu
  - id: ko_pyeonji
    english: "\uD3B8\uC9C0"
    meaning: letter (mail)
    partOfSpeech: n
    example: "\uAD50\uC218\uC9C4 \uC804\uCCB4\uC5D0\uAC8C \uC544\uC8FC \uC9C4\uD759
      \uBB3B\uC740 \uD3B8\uC9C0\uB97C \uBCF4\uB0BC \uAC83\uC774\uB2E4."
    exampleMeaning: I will send the whole faculty a very muddy letter.
    story: 218
    storyHeading: 
    romanization: pyeonji
  - id: ko_yeonguso
    english: "\uC5F0\uAD6C\uC18C"
    meaning: research institute
    partOfSpeech: n
    example: "\uC5F0\uAD6C\uC18C\uB294 \uC774 \uB9D0\uC744 \uD55C \uB9C8\uB514\uB3C4
      \uBBFF\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4."
    exampleMeaning: The institute will not believe a word of this.
    story: 219
    storyHeading: 
    romanization: yeonguso
  - id: ko_gigwan
    english: "\uAE30\uAD00"
    meaning: institution
    partOfSpeech: n
    example: "\uC5B4\uB5A4 \uAE30\uAD00\uB3C4 \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uC801
      \uC5C6\uB2E4."
    exampleMeaning: No agency has ever come this far.
    story: 220
    storyHeading: 
    romanization: gigwan
  - id: ko_sai
    english: "\uC0AC\uC774"
    meaning: between, gap
    partOfSpeech: n
    example: "\uC774 \uB3CC\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uB098\uB294 \uC678\uACC4\uC778
      \uAC19\uB2E4."
    exampleMeaning: I feel like an alien among these stones.
    story: 221
    storyHeading: 
    romanization: sai
  - id: ko_batda
    english: "\uBC1B\uB2E4"
    meaning: to receive
    partOfSpeech: v
    example: "\uB0B4\uAC00 \uBC1B\uC740 \uD6C8\uB828\uC740 \uC774\uC81C \uC544\uBB34
      \uC4F8\uBAA8\uB3C4 \uC5C6\uB294 \uAC83 \uAC19\uB2E4."
    exampleMeaning: None of my training seems relevant anymore.
    story: 222
    storyHeading: 
    romanization: batda
  - id: ko_isang
    english: "\uC774\uC0C1"
    meaning: more than, beyond
    partOfSpeech: n
    example: "\uB0B4 \uD1B5\uD589\uC99D\uC740 \uB354 \uC774\uC0C1 \uC720\uD6A8\uD558\uC9C0
      \uC54A\uB2E4."
    exampleMeaning: My travel pass is no longer valid.
    story: 223
    storyHeading: 
    romanization: isang
  - id: ko_imsi
    english: "\uC784\uC2DC"
    meaning: temporary
    partOfSpeech: n
    example: "\uC774 \uC57C\uC601\uC9C0\uB294 \uB2E4\uB978 \uBAA8\uB4E0 \uAC83\uCC98\uB7FC
      \uC784\uC2DC\uB2E4."
    exampleMeaning: This camp is temporary, like everything else.
    story: 224
    storyHeading: 
    romanization: imsi
  - id: ko_mutda
    english: "\uBB3B\uB2E4"
    meaning: to get stained
    partOfSpeech: v
    example: "\uB0B4 \uC678\uD22C\uC5D0 \uBB3B\uC740 \uC9C4\uD759 \uC5BC\uB8E9\uC740
      \uC9C0\uC6CC\uC9C0\uC9C0 \uC54A\uC744 \uAC83 \uAC19\uB2E4."
    exampleMeaning: The mud stains on my coat are permanent.
    story: 225
    storyHeading: 
    romanization: mutda
  - id: ko_danggida
    english: "\uB2F9\uAE30\uB2E4"
    meaning: to pull
    partOfSpeech: v
    example: "\uB2E4\uB9AC\uB97C \uAC74\uB108\uAE30 \uC804\uC5D0 \uB808\uBC84\uB97C
      \uB2F9\uAE30\uB294 \uAC83\uC774 \uB9E4\uC6B0 \uC911\uC694\uD558\uB2E4."
    exampleMeaning: It is crucial to pull the lever before crossing the bridge.
    story: 226
    storyHeading: 
    romanization: danggida
  - id: ko_gigye
    english: "\uAE30\uACC4"
    meaning: machine
    partOfSpeech: n
    example: "\uC61B \uAE30\uACC4 \uC7A5\uCE58\uAC00 \uB369\uAD74 \uB2E4\uB9AC\uB97C
      \uB0B4\uB838\uB2E4."
    exampleMeaning: An old mechanism lowered a vine bridge.
    story: 227
    storyHeading: 
    romanization: gigye
  - id: ko_geunyang
    english: "\uADF8\uB0E5"
    meaning: just
    partOfSpeech: adv
    example: "\uC774 \uC7A5\uCE58\uB294 \uC124\uBA85\uD560 \uC218 \uC5C6\uC9C0\uB9CC
      \uADF8\uB0E5 \uC791\uB3D9\uD55C\uB2E4."
    exampleMeaning: I cannot explain this device; it just works.
    story: 228
    storyHeading: 
    romanization: geunyang
  - id: ko_sayong
    english: "\uC0AC\uC6A9"
    meaning: use
    partOfSpeech: n
    example: "\uBD80\uD488 \uD558\uB098\uAC00 \uBE60\uC838 \uC788\uC5B4\uC11C \uB300\uC2E0
      \uB0B4 \uC21F\uAC00\uB77D\uC744 \uC0AC\uC6A9\uD588\uB2E4."
    exampleMeaning: One component was missing, so I used my spoon instead.
    story: 229
    storyHeading: 
    romanization: sayong
  - id: ko_apeuda
    english: "\uC544\uD504\uB2E4"
    meaning: to hurt, sick
    partOfSpeech: adj
    example: "\uBAB8\uC758 \uAD00\uC808\uC774 \uB2E4 \uC544\uD504\uB2E4."
    exampleMeaning: Every joint in my body hurts.
    story: 230
    storyHeading: 
    romanization: apeuda
  - id: ko_matda
    english: "\uB9DE\uB2E4"
    meaning: to be right
    partOfSpeech: v
    example: "\uB9DE\uB294 \uB9D0\uC744 \uD558\uC790 \uB3CC\uD310\uC774 \uBC00\uB824
      \uC5F4\uB838\uB2E4."
    exampleMeaning: A stone panel slid open when I said the right word.
    story: 231
    storyHeading: 
    romanization: matda
  - id: ko_mul
    english: "\uBB3C"
    meaning: water
    partOfSpeech: n
    example: "\uBB3C \uC704 \uB3CC \uB2E8\uC0C1\uC5D0\uC11C \uC26C\uC5C8\uB2E4."
    exampleMeaning: We rested on a stone platform above the water.
    story: 232
    storyHeading: 
    romanization: mul
  - id: ko_gibon
    english: "\uAE30\uBCF8"
    meaning: basics, foundation
    partOfSpeech: n
    example: "\uAE30\uC5B5\uC744 \uB354\uB4EC\uC5B4 \uC0C8\uB85C\uC6B4 \uC9C0\uB3C4\uC758
      \uAE30\uBCF8 \uD2C0\uC744 \uADF8\uB838\uB2E4."
    exampleMeaning: I sketched a framework for a new map from memory.
    story: 233
    storyHeading: "100\uC77C\uC9F8"
    romanization: gibon
  - id: ko_mandeulda
    english: "\uB9CC\uB4E4\uB2E4"
    meaning: to make
    partOfSpeech: v
    example: "\uACF5\uC2DD\uC744 \uD558\uB098 \uB9CC\uB4E4\uC5C8\uB2E4. \uAE38\uC744
      \uC783\uC740 \uC0C1\uD0DC\uC5D0 \uBC30\uACE0\uD514\uC744 \uB354\uD558\uBA74
      \uC2DC\uC778\uC774 \uB41C\uB2E4."
    exampleMeaning: 'I came up with a formula: being lost plus being hungry equals
      becoming a poet.'
    story: 234
    storyHeading: 
    romanization: mandeulda
  - id: ko_ijeon
    english: "\uC774\uC804"
    meaning: previous, before
    partOfSpeech: n
    example: "\uC774\uC804 \uC9C0\uB3C4\uB4E4\uC5D0\uB294 \uC5EC\uAE30\uC5D0 \uC544\uBB34\uAC83\uB3C4
      \uC5C6\uB2E4."
    exampleMeaning: Prior maps show nothing here at all.
    story: 235
    storyHeading: 
    romanization: ijeon
  - id: ko_eotteon
    english: "\uC5B4\uB5A4"
    meaning: some, what kind of
    partOfSpeech: adj
    example: "\uB3D9\uC2DC\uB300\uC758 \uC5B4\uB5A4 \uC9C0\uB3C4\uC5D0\uB3C4 \uC774\uACF3\uC740
      \uC5C6\uB2E4."
    exampleMeaning: No contemporary map shows this place either.
    story: 236
    storyHeading: 
    romanization: eotteon
  - id: ko_uija
    english: "\uC758\uC790"
    meaning: chair
    partOfSpeech: n
    example: "\uB0B4 \uC774\uC804 \uC0B6\uC5D0\uB294 \uC758\uC790\uAC00 \uC788\uC5C8\uB2E4."
    exampleMeaning: My former life had chairs.
    story: 237
    storyHeading: 
    romanization: uija
  - id: ko_dosi
    english: "\uB3C4\uC2DC"
    meaning: city
    partOfSpeech: n
    example: "\uB098\uB294 \uD55C\uB54C \uC2E0\uBC1C \uC2E0\uC740 \uB3C4\uC2DC \uC0AC\uB78C\uC774\uC5C8\uB2E4."
    exampleMeaning: I was an urban person once, with shoes.
    story: 238
    storyHeading: 
    romanization: dosi
  - id: ko_sesang
    english: "\uC138\uC0C1"
    meaning: world
    partOfSpeech: n
    example: "\uD55C\uB54C \uC9C0\uAD6C\uBCF8\uC774 \uC788\uC5C8\uB2E4. \uADF8\uB54C\uB294
      \uC138\uC0C1\uC774 \uB354 \uC791\uC544 \uBCF4\uC600\uB2E4."
    exampleMeaning: I once owned a globe. The world looked smaller then.
    story: 239
    storyHeading: 
    romanization: sesang
  - id: ko_yangmal
    english: "\uC591\uB9D0"
    meaning: socks
    partOfSpeech: n
    example: "\uC6B0\uC8FC\uB294 \uB0B4\uAC8C \uB9C8\uB978 \uC591\uB9D0 \uD558\uB098\uB97C
      \uBE5A\uC84C\uB2E4."
    exampleMeaning: The universe owes me one dry sock.
    story: 240
    storyHeading: 
    romanization: yangmal
  - id: ko_goreuda
    english: "\uACE0\uB974\uB2E4"
    meaning: to choose
    partOfSpeech: v
    example: "\uC9C4\uD759\uACFC \uBE44 \uC911 \uBB34\uC5C7\uC744 \uACE0\uB97C\uAE4C?
      \uD6C4\uC790\uB97C \uACE8\uB790\uB354\uB2C8 \uB458 \uB2E4 \uC5BB\uC5C8\uB2E4."
    exampleMeaning: Mud or rain? I chose the latter and got both.
    story: 241
    storyHeading: 
    romanization: goreuda
  - id: ko_poham
    english: "\uD3EC\uD568"
    meaning: inclusion
    partOfSpeech: n
    example: "\uB0B4 \uCD5C\uCD08 \uACC4\uD68D\uC5D0\uB294 \uC810\uC2EC\uC2DC\uAC04\uB3C4
      \uD3EC\uD568\uB418\uC5B4 \uC788\uC5C8\uB2E4."
    exampleMeaning: My initial plan even included a lunch break.
    story: 242
    storyHeading: 
    romanization: poham
  - id: ko_guchejeok
    english: "\uAD6C\uCCB4\uC801"
    meaning: specific, concrete
    partOfSpeech: adj
    example: "\uAD6C\uCCB4\uC801\uC778 \uACC4\uD68D\uC740 \uC5C6\uACE0 \uBC29\uD5A5\uB9CC
      \uC788\uB2E4."
    exampleMeaning: I have no concrete plan, only a direction.
    story: 243
    storyHeading: 
    romanization: guchejeok
  - id: ko_mokpyo
    english: "\uBAA9\uD45C"
    meaning: goal
    partOfSpeech: n
    example: "\uC774\uC81C \uB098\uC758 \uAD81\uADF9\uC801\uC778 \uBAA9\uD45C\uB294
      \uB9C8\uB978 \uACF3\uC5D0\uC11C \uD558\uB8FB\uBC24\uC744 \uBCF4\uB0B4\uB294
      \uAC83\uC774\uB2E4."
    exampleMeaning: My ultimate goal is now to spend one night somewhere dry.
    story: 244
    storyHeading: 
    romanization: mokpyo
  - id: ko_gyeolgwa
    english: "\uACB0\uACFC"
    meaning: result
    partOfSpeech: n
    example: "\uADF8 \uACC4\uD68D\uC758 \uACB0\uACFC\uB294 \uB0B4 \uC5BC\uAD74\uC5D0
      \uC801\uD600 \uC788\uB2E4."
    exampleMeaning: The outcome of that plan is written on my face.
    story: 245
    storyHeading: 
    romanization: gyeolgwa
  - id: ko_kiuda
    english: "\uD0A4\uC6B0\uB2E4"
    meaning: to raise, to grow
    partOfSpeech: v
    example: "\uC774 \uC815\uAE00\uC740 \uC778\uB0B4\uC2EC\uC774\uB098 \uAD11\uAE30\uB97C
      \uD0A4\uC6B4\uB2E4."
    exampleMeaning: This jungle will foster patience or madness.
    story: 246
    storyHeading: 
    romanization: kiuda
  - id: ko_yojeum
    english: "\uC694\uC998"
    meaning: these days
    partOfSpeech: n
    example: "\uC694\uC998 \uCD94\uC138\uB294 \uB9D0\uC740 \uC904\uACE0 \uAC1C\uAD6C\uB9AC\uB294
      \uB294\uB2E4."
    exampleMeaning: 'The current trend: fewer words, more frogs.'
    story: 247
    storyHeading: 
    romanization: yojeum
  - id: ko_tteoreojida
    english: "\uB5A8\uC5B4\uC9C0\uB2E4"
    meaning: to fall, to drop
    partOfSpeech: v
    example: "\uC14B\uC9F8 \uB2EC\uBD80\uD130 \uB0B4 \uCCA0\uC790\uAC00 \uB5A8\uC5B4\uC9C0\uAE30
      \uC2DC\uC791\uD588\uB2E4."
    exampleMeaning: My spelling began to decline in the third month.
    story: 248
    storyHeading: 
    romanization: tteoreojida
  - id: ko_mulgeon
    english: "\uBB3C\uAC74"
    meaning: thing, item
    partOfSpeech: n
    example: "\uB0B4\uAC00 \uCD5C\uADFC\uC5D0 \uC5BB\uC740 \uBB3C\uAC74\uC740 \uC190\uC7A1\uC774\uAC00
      \uC5C6\uB294 \uC21F\uAC00\uB77D\uC774\uB2E4."
    exampleMeaning: My latest acquisition is a spoon without a handle.
    story: 249
    storyHeading: 
    romanization: mulgeon
  - id: ko_jeomjeom
    english: "\uC810\uC810"
    meaning: gradually
    partOfSpeech: adv
    example: "\uB0B4 \uC2DD\uB2E8\uC758 \uBCC0\uD654 \uACFC\uC815\uC774 \uC810\uC810
      \uBB34\uC11C\uC6CC\uC9C0\uACE0 \uC788\uB2E4."
    exampleMeaning: The evolution of my diet is becoming frightening.
    story: 250
    storyHeading: 
    romanization: jeomjeom
  - id: ko_seuseuro
    english: "\uC2A4\uC2A4\uB85C"
    meaning: by oneself
    partOfSpeech: adv
    example: "\uBC8C\uB808\uB294 \uC88B\uC740 \uB2E8\uBC31\uC9C8 \uACF5\uAE09\uC6D0\uC774\uB77C\uACE0
      \uACC4\uC18D \uC2A4\uC2A4\uB85C\uC5D0\uAC8C \uB9D0\uD55C\uB2E4."
    exampleMeaning: Bugs are a good source of protein, I keep telling myself.
    story: 251
    storyHeading: 
    romanization: seuseuro
  - id: ko_jul
    english: "\uC904"
    meaning: line, row
    partOfSpeech: n
    example: "\uB0B4 \uD558\uB8E8 \uC0DD\uC0B0\uB7C9\uC740 \uC138 \uC904\uACFC \uB208\uBB3C
      \uD55C \uBC29\uC6B8\uC774\uB2E4."
    exampleMeaning: My daily output is three lines and one tear.
    story: 252
    storyHeading: 
    romanization: jul
  - id: ko_sori
    english: "\uC18C\uB9AC"
    meaning: sound
    partOfSpeech: n
    example: "\uB178\uC0C8\uAC00 \uBCF4\uD0E0 \uAC83\uC740 \uAE38\uACE0 \uBB34\uB840\uD55C
      \uC18C\uB9AC\uC600\uB2E4."
    exampleMeaning: The mule's input was a long, rude noise.
    story: 253
    storyHeading: 
    romanization: sori
  - id: ko_baengman
    english: "\uBC31\uB9CC"
    meaning: a million
    partOfSpeech: n
    example: "\uAC1C\uAD6C\uB9AC\uB294 \uBC31\uB9CC \uB9C8\uB9AC\uACE0 \uB098\uB294
      \uD558\uB098\uB2E4."
    exampleMeaning: There are a million frogs and one of me.
    story: 254
    storyHeading: 
    romanization: baengman
  - id: ko_beolle
    english: "\uBC8C\uB808"
    meaning: bug, insect
    partOfSpeech: n
    example: "\uC218\uB9CE\uC740 \uBC8C\uB808 \uBB3C\uB9B0 \uC790\uAD6D\uC774 \uB0B4
      \uD314\uC744 \uB4A4\uB36E\uACE0 \uC788\uB2E4."
    exampleMeaning: Numerous insect bites cover my arms.
    story: 255
    storyHeading: 
    romanization: beolle
  - id: ko_gumeong
    english: "\uAD6C\uBA4D"
    meaning: hole
    partOfSpeech: n
    example: "\uBAA8\uC790\uC5D0 \uAD6C\uBA4D\uC774 \uC5EC\uB7EC \uAC1C \uC788\uB2E4."
    exampleMeaning: I have multiple holes in my hat.
    story: 256
    storyHeading: 
    romanization: gumeong
  - id: ko_bakkuda
    english: "\uBC14\uAFB8\uB2E4"
    meaning: to exchange, to swap
    partOfSpeech: v
    example: "\uD2F0\uC288 \uD55C \uC7A5\uB9CC \uC900\uB2E4\uBA74 \uC9C0\uB3C4 \uD55C
      \uC7A5\uACFC\uB3C4 \uBC14\uAFB8\uACA0\uB2E4."
    exampleMeaning: I would trade a map for a single tissue.
    story: 257
    storyHeading: 
    romanization: bakkuda
  - id: ko_susul
    english: "\uC218\uC220"
    meaning: surgery
    partOfSpeech: n
    example: "\uD3EC\uD06C\uB97C \uC0AC\uC6A9\uD574 \uB0B4 \uC7A5\uD654\uB97C \uC218\uC220\uD588\uB2E4."
    exampleMeaning: I performed surgery on my boot using a fork.
    story: 258
    storyHeading: 
    romanization: susul
  - id: ko_geul
    english: "\uAE00"
    meaning: writing, text
    partOfSpeech: n
    example: "\uC774 \uC77C\uC9C0\uC5D0 \uAE00\uC744 \uC4F0\uB294 \uAC83\uC774 \uB0B4
      \uC720\uC77C\uD55C \uCE58\uB8CC\uBC95\uC774\uB2E4."
    exampleMeaning: Writing in this journal is my only therapy.
    story: 259
    storyHeading: 
    romanization: geul
  - id: ko_peojida
    english: "\uD37C\uC9C0\uB2E4"
    meaning: to spread
    partOfSpeech: v
    example: "\uC5EC\uAE30\uC11C\uB294 \uC78A\uC74C\uC774 \uBC14\uC774\uB7EC\uC2A4\uCC98\uB7FC
      \uD37C\uC9C4\uB2E4."
    exampleMeaning: Forgetting spreads like a virus here.
    story: 260
    storyHeading: 
    romanization: peojida
  - id: ko_deopda
    english: "\uB36E\uB2E4"
    meaning: to cover
    partOfSpeech: v
    example: "\uBFCC\uB9AC\uB9DD\uC774 \uB545\uC744 \uB36E\uACE0 \uC788\uB2E4."
    exampleMeaning: A network of roots covers the ground.
    story: 261
    storyHeading: 
    romanization: deopda
  - id: ko_beon
    english: "\uBC88"
    meaning: times (counter)
    partOfSpeech: n
    example: "\uD55C \uBC88\uC758 \uD0C0\uACA9\uC73C\uB85C \uB369\uAD74\uC744 \uC798\uB790\uB2E4."
    exampleMeaning: With one stroke, I cut the vine.
    story: 262
    storyHeading: 
    romanization: beon
  - id: ko_teullida
    english: "\uD2C0\uB9AC\uB2E4"
    meaning: to be wrong
    partOfSpeech: v
    example: "\uB300\uB2F4\uD55C \uACC4\uD68D\uC774\uC5C8\uACE0, \uD2C0\uB9B0 \uACC4\uD68D\uC774\uAE30\uB3C4
      \uD588\uB2E4."
    exampleMeaning: It was a bold plan, and it was also wrong.
    story: 263
    storyHeading: 
    romanization: teullida
  - id: ko_bap
    english: "\uBC25"
    meaning: cooked rice
    partOfSpeech: n
    example: "\uB530\uB73B\uD55C \uBC25 \uD55C \uB07C\uB294 \uD300 \uC804\uCCB4\uB97C
      \uBD81\uB3CB\uC6B4\uB2E4."
    exampleMeaning: One warm meal can boost the whole crew.
    story: 264
    storyHeading: 
    romanization: bap
  - id: ko_bubun
    english: "\uBD80\uBD84"
    meaning: part
    partOfSpeech: n
    example: "\uC9C0\uB3C4\uC758 \uC774 \uBD80\uBD84\uC740 \uCEE4\uD53C \uC5BC\uB8E9\uBFD0\uC774\uB2E4."
    exampleMeaning: This sector of the map is only a coffee stain.
    story: 265
    storyHeading: 
    romanization: bubun
  - id: ko_kkeunnada
    english: "\uB05D\uB098\uB2E4"
    meaning: to end, to finish
    partOfSpeech: v
    example: "\uB450\uAEBC\uBE44\uC758 \uC601\uC5ED\uC740 \uD3ED\uD3EC\uC5D0\uC11C
      \uB05D\uB09C\uB2E4."
    exampleMeaning: The toad's domain ends at the falls.
    story: 266
    storyHeading: 
    romanization: kkeunnada
  - id: ko_nada
    english: "\uB098\uB2E4"
    meaning: to occur, to come out
    partOfSpeech: v
    example: "\uAC15\uC758 \uC885\uC810\uC740 \uB545\uC5D0 \uB09C \uAD6C\uBA4D\uC774\uC5C8\uB2E4."
    exampleMeaning: The river's terminal point was a hole in the ground.
    story: 267
    storyHeading: 
    romanization: nada
  - id: ko_jopda
    english: "\uC881\uB2E4"
    meaning: narrow
    partOfSpeech: adj
    example: "\uC881\uC740 \uD1B5\uB85C\uAC00 \uAC15 \uC544\uB798\uB85C \uC774\uC5B4\uC84C\uB2E4."
    exampleMeaning: A narrow passage led down under the river.
    story: 268
    storyHeading: "\uB3D9\uAD74"
    romanization: jopda
  - id: ko_bakkat
    english: "\uBC14\uAE65"
    meaning: outside
    partOfSpeech: n
    example: "\uACE7 \uBC14\uAE65 \uBE5B\uC774 \uB2FF\uC9C0 \uC54A\uC558\uB2E4."
    exampleMeaning: Soon no external light reached us.
    story: 269
    storyHeading: 
    romanization: bakkat
  - id: ko_arae
    english: "\uC544\uB798"
    meaning: below, under
    partOfSpeech: n
    example: "\uADF8 \uC544\uB798\uB294 \uC789\uD06C\uCC98\uB7FC \uAC80\uC740 \uC61B
      \uAD11\uC0B0\uC774\uC5C8\uB2E4."
    exampleMeaning: Down there was an old mine, black as ink.
    story: 270
    storyHeading: 
    romanization: arae
  - id: ko_hwahak
    english: "\uD654\uD559"
    meaning: chemistry
    partOfSpeech: n
    example: "\uAC80\uC740 \uBB3C\uC5D0\uC11C \uD654\uD559 \uB0C4\uC0C8\uAC00 \uC62C\uB77C\uC654\uB2E4."
    exampleMeaning: A chemical smell rose from the black water.
    story: 271
    storyHeading: 
    romanization: hwahak
  - id: ko_jagyonghada
    english: "\uC791\uC6A9\uD558\uB2E4"
    meaning: to act (on), to work
    partOfSpeech: v
    example: "\uAC70\uBBF8 \uCE68\uC740 \uC885\uC774\uC5D0 \uC0B0\uCC98\uB7FC \uC791\uC6A9\uD55C\uB2E4."
    exampleMeaning: Spider spit works like acid on paper.
    story: 272
    storyHeading: 
    romanization: jagyonghada
  - id: ko_eodum
    english: "\uC5B4\uB460"
    meaning: darkness
    partOfSpeech: n
    example: "\uB178\uC0C8\uB294 \uC5B4\uB460 \uC18D \uC77C\uC5D0 \uCC38\uAC00\uD558\uAE30\uB97C
      \uAC70\uBD80\uD55C\uB2E4."
    exampleMeaning: The mule refuses to participate in the dark.
    story: 273
    storyHeading: 
    romanization: eodum
  - id: ko_gwansim
    english: "\uAD00\uC2EC"
    meaning: interest
    partOfSpeech: n
    example: "\uB450\uB824\uC6C0\uB4E4\uC774 \uB0B4 \uAD00\uC2EC\uC744 \uB450\uACE0
      \uACBD\uC7C1\uD55C\uB2E4."
    exampleMeaning: My fears compete for my attention.
    story: 274
    storyHeading: 
    romanization: gwansim
  - id: ko_tteoollida
    english: "\uB5A0\uC62C\uB9AC\uB2E4"
    meaning: to recall
    partOfSpeech: v
    example: "\uB9D0\uC744 \uB5A0\uC62C\uB9AC\uC790 \uC218\uC815\uC774 \uBE5B\uB0AC\uB2E4."
    exampleMeaning: A crystal glowed when I remembered a word.
    story: 275
    storyHeading: 
    romanization: tteoollida
  - id: ko_bit
    english: "\uBE5B"
    meaning: light
    partOfSpeech: n
    example: "\uB0B4\uAC00 \uAC00\uC9C4 \uC720\uC77C\uD55C \uBE5B\uC740 \uC791\uAC8C
      \uBE5B\uB098\uB294 \uB3CC \uD558\uB098\uB2E4."
    exampleMeaning: My sole source of light is a small glowing stone.
    story: 276
    storyHeading: 
    romanization: bit
  - id: ko_son
    english: "\uC190"
    meaning: hand
    partOfSpeech: n
    example: "\uB9C8\uC9C0\uB9C9 \uCE21\uB7C9\uC740 \uC190\uC73C\uB85C \uB354\uB4EC\uC5B4
      \uC218\uD589\uD55C\uB2E4."
    exampleMeaning: I conduct my last survey by touch.
    story: 277
    storyHeading: 
    romanization: son
  - id: ko_balgyeonhada
    english: "\uBC1C\uACAC\uD558\uB2E4"
    meaning: to discover
    partOfSpeech: v
    example: "\uAC11\uC637 \uC18D\uC774 \uD145 \uBE48 \uB179\uC2A8 \uAE30\uC0AC\uAC00
      \uACBD\uBE44\uB97C \uC11C\uACE0 \uC788\uB294 \uAC83\uC744 \uBC1C\uACAC\uD588\uB2E4."
    exampleMeaning: I found a rusted knight standing guard, with nothing inside its
      armor.
    story: 278
    storyHeading: 
    romanization: balgyeonhada
  - id: ko_gadeuk
    english: "\uAC00\uB4DD"
    meaning: full
    partOfSpeech: adv
    example: "\uAC00\uC7A5 \uD070 \uBC29\uC740 \uC7A0\uB4E0 \uB369\uAD74\uB85C \uAC00\uB4DD\uD588\uB2E4."
    exampleMeaning: The largest chamber was full of sleeping vines.
    story: 279
    storyHeading: 
    romanization: gadeuk
  - id: ko_gachida
    english: "\uAC07\uD788\uB2E4"
    meaning: to be trapped
    partOfSpeech: v
    example: "\uB369\uAD74\uC758 \uC911\uC2EC\uBD80\uC5D0\uC11C \uADF8 \uC548\uC5D0
      \uAC07\uD78C \uBB38\uC7A5\uB4E4\uC744 \uBC1C\uACAC\uD588\uB2E4."
    exampleMeaning: At the core of the vine, I found sentences trapped inside.
    story: 280
    storyHeading: 
    romanization: gachida
  - id: ko_eopsi
    english: "\uC5C6\uC774"
    meaning: without
    partOfSpeech: adv
    example: "\uC774\uB984 \uC5C6\uC774 \uC810 \uC138 \uAC1C\uB9CC \uC788\uB294 \uBB34\uB364\uC744
      \uCC3E\uC558\uB2E4."
    exampleMeaning: I found a grave with no name, only three dots.
    story: 281
    storyHeading: 
    romanization: eopsi
  - id: ko_unmyeong
    english: "\uC6B4\uBA85"
    meaning: fate, destiny
    partOfSpeech: n
    example: "\uC694\uB9AC\uC0AC\uC758 \uC6B4\uBA85\uC740 \uC774\uC0C1\uD588\uB2E4.
      \uBAA8\uB4E0 \uB9D0\uC774 \uC810\uC73C\uB85C \uB05D\uB0AC\uB2E4."
    exampleMeaning: 'The cook met a strange fate: every word ended in dots.'
    story: 282
    storyHeading: 
    romanization: unmyeong
  - id: ko_jangnyesik
    english: "\uC7A5\uB840\uC2DD"
    meaning: funeral
    partOfSpeech: n
    example: "\uB9C8\uC9C0\uB9C9 \uD39C\uC758 \uC791\uC740 \uC7A5\uB840\uC2DD\uC744
      \uCE58\uB800\uB2E4."
    exampleMeaning: We held a small funeral for my last pen.
    story: 283
    storyHeading: 
    romanization: jangnyesik
  - id: ko_jikida
    english: "\uC9C0\uD0A4\uB2E4"
    meaning: to keep, to protect
    partOfSpeech: v
    example: "\uB2E8\uC5B4 \uD558\uB098\uB97C \uC9C0\uD0A4\uB824\uBA74 \uB2E4\uB978
      \uB2E8\uC5B4 \uD558\uB098\uB97C \uD76C\uC0DD\uD574\uC57C \uD55C\uB2E4."
    exampleMeaning: Keeping one word means making the sacrifice of another.
    story: 284
    storyHeading: 
    romanization: jikida
  - id: ko_han
    english: "\uD55C"
    meaning: one, a
    partOfSpeech: adj
    example: "\uB9C8\uC9C0\uB9C9 \uD55C \uCABD\uC5D0 \uC804\uB150\uD55C\uB2E4."
    exampleMeaning: I commit myself to one last page.
    story: 285
    storyHeading: 
    romanization: han
  - id: ko_geulssi
    english: "\uAE00\uC528"
    meaning: handwriting
    partOfSpeech: n
    example: "\uBE5B\uC774 \uBCBD\uC758 \uAE00\uC528\uB97C \uB4DC\uB7EC\uB0B4\uAE30
      \uC2DC\uC791\uD588\uB2E4."
    exampleMeaning: The light began to reveal writing on the walls.
    story: 286
    storyHeading: "\uB9C8\uC9C0\uB9C9 \uCABD"
    romanization: geulssi
  - id: ko_samak
    english: "\uC0AC\uB9C9"
    meaning: desert
    partOfSpeech: n
    example: "\uADF8\uACF3\uC5D0\uB294 \uBAA8\uB4E0 \uB9D0\uC758 \uAE30\uC6D0\uC774
      \uC0AC\uB9C9 \uC544\uB798\uC5D0 \uC788\uB2E4\uACE0 \uC801\uD600 \uC788\uC5C8\uB2E4."
    exampleMeaning: It said that the origin of all words lay beneath the desert.
    story: 287
    storyHeading: 
    romanization: samak
  - id: ko_naeryeogada
    english: "\uB0B4\uB824\uAC00\uB2E4"
    meaning: to go down
    partOfSpeech: v
    example: "\uC774 \uC5EC\uC815\uC758 \uB9C8\uC9C0\uB9C9 \uB2E8\uACC4\uB294 \uC544\uB798\uB85C
      \uB0B4\uB824\uAC00\uB294 \uAC83\uC774\uB2E4."
    exampleMeaning: The final phase of this journey is the descent below.
    story: 288
    storyHeading: 
    romanization: naeryeogada
  - id: ko_doragada
    english: "\uB3CC\uC544\uAC00\uB2E4"
    meaning: to go back
    partOfSpeech: v
    example: "\uB178\uC0C8\uB294 \uBCF4\uC0C1\uC73C\uB85C \uBC1B\uC740 \uC0AC\uACFC\uC640
      \uC774 \uC77C\uC9C0\uB97C \uAC00\uC9C0\uACE0 \uB3CC\uC544\uAC08 \uAC83\uC774\uB2E4."
    exampleMeaning: The mule will return with this journal and an apple as its reward.
    story: 289
    storyHeading: 
    romanization: doragada
  - id: ko_jeungin
    english: "\uC99D\uC778"
    meaning: witness
    partOfSpeech: n
    example: "\uC774\uAC78 \uC77D\uACE0 \uC788\uB2E4\uBA74, \uB2F9\uC2E0\uC774 \uB0B4
      \uC99D\uC778\uC774\uB2E4."
    exampleMeaning: If you read this, you are my witness.
    story: 290
    storyHeading: 
    romanization: jeungin
  - id: ko_chingu
    english: "\uCE5C\uAD6C"
    meaning: friend
    partOfSpeech: n
    example: "\uB098\uB294 \uCE5C\uAD6C\uC640 \uD568\uAED8 \uC2DC\uC7A5\uC5D0 \uAC14\uB2E4."
    exampleMeaning: I went to the market with a friend.
    story: 0
    storyHeading: 
    romanization: chingu
  - id: ko_nalssi
    english: "\uB0A0\uC528"
    meaning: weather
    partOfSpeech: n
    example: "\uC624\uB298\uC740 \uB0A0\uC528\uAC00 \uC815\uB9D0 \uC88B\uB2E4."
    exampleMeaning: The weather is really nice today.
    story: 0
    storyHeading: 
    romanization: nalssi
  - id: ko_areumdapda
    english: "\uC544\uB984\uB2F5\uB2E4"
    meaning: beautiful
    partOfSpeech: adj
    example: "\uC774 \uC815\uC6D0\uC740 \uC815\uB9D0 \uC544\uB984\uB2F5\uB2E4."
    exampleMeaning: This garden is truly beautiful.
    story: 0
    storyHeading: 
    romanization: areumdapda
  - id: ko_haengbokada
    english: "\uD589\uBCF5\uD558\uB2E4"
    meaning: happy
    partOfSpeech: adj
    example: "\uAC00\uC871\uACFC \uD568\uAED8 \uC788\uC5B4\uC11C \uD589\uBCF5\uD558\uB2E4."
    exampleMeaning: I am happy to be with my family.
    story: 0
    storyHeading: 
    romanization: haengbokada
  - id: ko_sarang
    english: "\uC0AC\uB791"
    meaning: love
    partOfSpeech: n
    example: "\uC5B4\uBA38\uB2C8\uC758 \uC0AC\uB791\uC5D0\uB294 \uB05D\uC774 \uC5C6\uB2E4."
    exampleMeaning: A mother's love has no end.
    story: 0
    storyHeading: 
    romanization: sarang
  - id: ko_yeoreum
    english: "\uC5EC\uB984"
    meaning: summer
    partOfSpeech: n
    example: "\uC5EC\uB984\uC5D0\uB294 \uBC14\uB2E4\uC5D0 \uAC04\uB2E4."
    exampleMeaning: In summer, I go to the sea.
    story: 0
    storyHeading: 
    romanization: yeoreum
  - id: ko_gaeul
    english: "\uAC00\uC744"
    meaning: autumn, fall
    partOfSpeech: n
    example: "\uAC00\uC744\uC774 \uB418\uBA74 \uB098\uBB47\uC78E\uC774 \uBD89\uAC8C
      \uBB3C\uB4E0\uB2E4."
    exampleMeaning: When autumn comes, the leaves turn red.
    story: 0
    storyHeading: 
    romanization: gaeul
  - id: ko_bom
    english: "\uBD04"
    meaning: spring (season)
    partOfSpeech: n
    example: "\uBD04\uC774 \uC624\uBA74 \uB4E4\uD310\uC774 \uD478\uB974\uAC8C \uBCC0\uD55C\uB2E4."
    exampleMeaning: When spring comes, the fields turn green.
    story: 0
    storyHeading: 
    romanization: bom
  - id: ko_kkot
    english: "\uAF43"
    meaning: flower
    partOfSpeech: n
    example: "\uAE38\uAC00\uC5D0 \uC791\uC740 \uAF43\uC774 \uD53C\uC5C8\uB2E4."
    exampleMeaning: A small flower bloomed by the road.
    story: 0
    storyHeading: 
    romanization: kkot
  - id: ko_eumak
    english: "\uC74C\uC545"
    meaning: music
    partOfSpeech: n
    example: "\uB098\uB294 \uB9E4\uC77C \uC544\uCE68 \uC74C\uC545\uC744 \uB4E3\uB294\uB2E4."
    exampleMeaning: I listen to music every morning.
    story: 0
    storyHeading: 
    romanization: eumak
